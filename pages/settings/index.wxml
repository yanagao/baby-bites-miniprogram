<t-navbar z-index="100" title="设置" placeholder left-arrow />
<t-notice-bar wx:if="{{warning}}" visible theme="warning" content="{{warning}}" />
<view class="settings-page">
  <view class="settings-section">
    <view class="settings-section-title">微信账号同步</view>
    <view class="settings-card settings-sync-card">
      <view class="settings-sync-heading">
        <view class="settings-status-dot settings-status-dot--{{syncState}}" aria-hidden="true"></view>
        <text class="settings-sync-title">{{syncTitle}}</text>
      </view>
      <view wx:if="{{syncMessage}}" class="settings-description settings-sync-description">{{syncMessage}}</view>
      <view wx:if="{{syncState !== 'unconfigured'}}" class="settings-sync-footer">
        <text class="settings-sync-time">{{syncTime || '尚无成功同步记录'}}</text>
        <t-button theme="primary" size="small" loading="{{syncState === 'syncing'}}" disabled="{{syncState === 'syncing'}}" bind:tap="syncNow">立即同步</t-button>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <view class="settings-section-title">数据与备份</view>
    <view class="settings-card settings-overview">
      <view class="settings-counts">
        <view class="settings-count">
          <text class="settings-count-value">{{counts.recipeCount || 0}}</text>
          <text class="settings-count-label">道菜谱</text>
        </view>
        <view class="settings-count settings-count--logs">
          <text class="settings-count-value">{{counts.logCount || 0}}</text>
          <text class="settings-count-label">次用餐记录</text>
        </view>
      </view>
      <view class="settings-description settings-storage-description">{{storageDescription}}</view>
    </view>
    <view class="settings-card settings-backup-actions">
      <t-cell-group>
        <t-cell t-class-center="settings-cell-main" t-class-note="settings-cell-note" title="导出备份文件" description="保存菜谱、照片和用餐记录" note="{{busy ? '处理中…' : ''}}" arrow="{{!busy}}" hover="{{!busy}}" bind:click="exportBackup" />
        <t-cell t-class-center="settings-cell-main" t-class-note="settings-cell-note" title="导入备份文件" description="从微信聊天选择 JSON 文件，最多 20 MB" note="{{busy ? '处理中…' : ''}}" arrow="{{!busy}}" hover="{{!busy}}" bind:click="chooseBackup" />
      </t-cell-group>
    </view>
    <view class="settings-card settings-backup-more">
      <t-collapse disabled="{{busy}}">
        <t-collapse-panel value="backup-methods" header="其他备份方式">
          <t-cell t-class-center="settings-cell-main" t-class-note="settings-cell-note" title="复制备份内容" description="复制为文字，方便自行保存" arrow="{{!busy}}" hover="{{!busy}}" bind:click="copyBackup" />
          <t-cell t-class-center="settings-cell-main" t-class-note="settings-cell-note" title="粘贴备份内容" note="{{showPaste ? '收起' : ''}}" arrow="{{!busy}}" hover="{{!busy}}" bind:click="togglePaste" />
          <view wx:if="{{showPaste}}" class="settings-paste">
            <t-textarea label="备份内容" maxlength="-1" disabled="{{busy}}" value="{{backupText}}" bind:change="inputBackup" placeholder="粘贴小口袋备份的 JSON 内容" />
            <view class="settings-paste-action">
              <t-button theme="primary" size="small" disabled="{{busy}}" loading="{{busy}}" bind:tap="confirmImport">合并导入</t-button>
            </view>
          </view>
          <view class="settings-backup-help">
            <view class="settings-help-title">备份说明</view>
            <view class="settings-description">照片支持 JPG、PNG、WebP，含照片的备份建议通过文件导入。也可导入网页版「小口袋」的 JSON 备份。</view>
          </view>
        </t-collapse-panel>
      </t-collapse>
    </view>
  </view>
  <view wx:if="{{error}}" class="settings-error">
    <t-notice-bar visible theme="error" content="{{error}}" />
  </view>
  <view class="settings-version">
    <text class="settings-version-name">小口袋</text>
    <text class="settings-version-number">版本 1.3.0</text>
  </view>
</view>
<t-dialog visible="{{importVisible}}" title="合并这份备份？" content="将菜谱和用餐记录合并到本机；相同内容保留较新的修改。" confirm-btn="{{importConfirmButton}}" cancel-btn="取消" bind:confirm="confirmImportDialog" bind:cancel="cancelImportDialog" />
<t-dialog visible="{{exportVisible}}" title="备份已准备好" content="{{exportDescription}}" confirm-btn="{{exportConfirmButton}}" cancel-btn="取消" bind:confirm="confirmExportDialog" bind:cancel="cancelExportDialog" />
