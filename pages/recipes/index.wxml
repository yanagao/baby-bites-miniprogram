<t-navbar z-index="100" title="我的食谱" placeholder />
<t-notice-bar wx:if="{{warning}}" visible theme="warning" content="{{warning}}" />
<view class="page-shell cookbook-page">
  <view class="cookbook-heading">
    <view class="cookbook-heading-copy">
      <view class="cookbook-title">宝宝的小食谱</view>
      <view class="cookbook-subtitle">好好收藏，每一道喜欢的味道</view>
    </view>
    <image class="cookbook-mascot" src="/assets/cute/pocket-mascot.png" mode="aspectFit" aria-hidden="true" />
  </view>
  <view wx:if="{{socialEnabled}}" class="cookbook-social panel">
    <t-cell title="我的主页" note="分享公开菜谱" arrow bind:click="openProfile" />
    <t-cell title="关注的菜谱" note="看看好友做了什么" arrow bind:click="openFollowing" />
  </view>
  <view class="cookbook-search">
    <t-search value="{{search}}" bind:change="searchInput" placeholder="搜索菜谱或食材" shape="round" maxlength="60" />
  </view>
  <view class="cookbook-collection-tabs">
    <t-tabs value="{{onlyFavorites ? 'favorites' : 'all'}}" theme="tag" space-evenly="{{false}}" swipeable="{{false}}" split="{{false}}" bind:change="changeCollection">
      <t-tab-panel value="all" label="全部食谱" />
      <t-tab-panel value="favorites" label="我的收藏" />
    </t-tabs>
  </view>
  <view class="cookbook-filters">
    <t-collapse>
      <t-collapse-panel value="filters" header="筛选与排序" header-right-content="{{filterSummary}}">
        <t-dropdown-menu>
          <t-dropdown-item options="{{categoryOptions}}" value="{{category}}" bind:change="chooseCategory" />
          <t-dropdown-item options="{{textureOptions}}" value="{{texture}}" bind:change="changeTexture" />
          <t-dropdown-item options="{{sortOptions}}" value="{{sort}}" bind:change="changeSort" />
        </t-dropdown-menu>
        <t-cell wx:if="{{hasFilters}}">
          <t-button slot="right-icon" theme="primary" variant="text" bind:tap="resetFilters">清除筛选</t-button>
        </t-cell>
      </t-collapse-panel>
    </t-collapse>
  </view>
  <view class="cookbook-list-heading">
    <text class="cookbook-count">{{recipes.length}} 道{{onlyFavorites ? '收藏' : '食谱'}}</text>
    <view class="cookbook-add"><t-button theme="primary" size="small" icon="add" shape="round" bind:tap="addRecipe">添加菜谱</t-button></view>
  </view>
  <view class="cookbook-list">
    <recipe-card wx:for="{{recipes}}" wx:key="id" recipe="{{item}}" bind:open="openRecipe" />
  </view>
  <t-empty wx:if="{{!recipes.length}}" description="{{hasFilters ? '没有符合条件的菜谱，可以清除筛选后再试' : '还没有菜谱，添加一道做过的辅食吧'}}">
    <t-button wx:if="{{hasFilters}}" slot="action" theme="primary" bind:tap="resetFilters">清除筛选</t-button>
    <t-button wx:else slot="action" theme="primary" bind:tap="addRecipe">添加菜谱</t-button>
  </t-empty>
</view>
<bottom-navigation id="bottom-navigation" />
