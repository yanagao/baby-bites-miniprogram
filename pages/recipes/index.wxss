.cookbook-page {padding:0 28rpx 30rpx;}
.cookbook-toolbar {display:flex;align-items:center;gap:10rpx;margin-bottom:18rpx;}
.cookbook-collection-tabs {flex:1;min-width:0;margin-left:-16rpx;--td-tab-nav-bg-color:transparent;--td-tab-item-height:88rpx;--td-tab-item-active-color:#345158;--td-tab-item-color:#82969a;--td-tab-track-color:#55bba4;--td-tab-track-thickness:3rpx;--td-tab-track-width:32rpx;--td-spacer-2:24rpx;--td-tab-font:var(--font-body) / var(--line-height-body) var(--td-font-family);}
.cookbook-filter-button {position:relative;flex:none;display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;padding:0;margin:0;background:transparent;color:#82969a;}
.cookbook-filter-button::after {border:0;}
.cookbook-filter-button>text {position:absolute;top:0;right:-2rpx;border-radius:50%;min-width:32rpx;height:32rpx;text-align:center;font-size:var(--font-caption);line-height:32rpx;background:#55bba4;color:#153f37;}
.cookbook-filter-active {color:#439e86;}
.cookbook-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:20rpx;row-gap:26rpx;align-items:start;}
.cookbook-privacy-note {display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);padding:0 2rpx 14rpx;}
.cookbook-privacy-note>text {flex:1;min-width:0;overflow-wrap:anywhere;}
.cookbook-search-summary {display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding-bottom:12rpx;color:#82969a;font-size:var(--font-secondary);}
.cookbook-search-summary>text {flex:1;min-width:0;overflow-wrap:anywhere;}
.cookbook-add {padding:20rpx 0 6rpx;text-align:center;}
.cookbook-filter-sheet {max-height:88vh;overflow-y:auto;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:#ffffff;border-radius:28rpx 28rpx 0 0;}
.cookbook-filter-title {font-size:var(--font-section-title);font-weight:600;line-height:var(--line-height-body);margin:0 0 20rpx;color:#345158;}
.cookbook-filter-scroll {max-height:60vh;}
.cookbook-search {margin-bottom:24rpx;--td-search-bg-color:#eff8f8;--td-search-height:80rpx;--td-search-font:var(--font-body) / var(--line-height-body) var(--td-font-family);--td-search-icon-size:30rpx;--td-search-clear-icon-size:28rpx;--td-search-placeholder-color:#9bafb3;}
.cookbook-filter-label {font-size:var(--font-section-title);font-weight:600;line-height:var(--line-height-body);margin:22rpx 0 12rpx;color:#345158;}
.cookbook-filter-options {display:flex;flex-wrap:wrap;gap:12rpx;}
.cookbook-filter-option {padding:11rpx 22rpx;margin:0;background:#eff8f8;border:1rpx solid transparent;border-radius:999rpx;color:#82969a;font-size:var(--font-body);line-height:var(--line-height-body);}
.cookbook-filter-option::after {border:0;}
.cookbook-filter-option.selected {background:#55bba4;border-color:#55bba4;color:#153f37;}
.cookbook-filter-actions {display:flex;align-items:center;gap:18rpx;margin-top:28rpx;--td-button-medium-font:500 var(--font-body) / var(--line-height-body) var(--td-font-family);--td-button-medium-height:88rpx;}
.cookbook-filter-actions>t-button:last-child {flex:1;}
