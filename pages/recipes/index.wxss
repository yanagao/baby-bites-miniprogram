.cookbook-page { padding-top: 12rpx; }
.cookbook-heading { display: flex; align-items: center; justify-content: space-between; min-height: 128rpx; margin-bottom: 12rpx; }
.cookbook-heading-copy { flex: 1; min-width: 0; }
.cookbook-title { font-family: PocketBrush, 'Kaiti SC', 'STKaiti', 'PingFang SC', sans-serif; font-size: 50rpx; font-weight: 700; line-height: 1.25; color: #42251e; }
.cookbook-subtitle { margin-top: 8rpx; color: #8a786b; font-size: 25rpx; line-height: 1.5; }
.cookbook-mascot { flex: none; width: 122rpx; height: 122rpx; margin-left: 10rpx; transform: rotate(-5deg); }
.cookbook-search { --td-search-bg-color: #f0ece3; --td-search-height: 72rpx; --td-search-font: 28rpx / 44rpx -apple-system, BlinkMacSystemFont, sans-serif; --td-search-icon-color: #67564c; --td-search-text-color: #3b241f; --td-search-placeholder-color: #93877e; }
.cookbook-collection-tabs { margin: 8rpx -16rpx 0; --td-tab-nav-bg-color: transparent; --td-tab-item-tag-bg: #ffede7; --td-tab-item-tag-active-bg: #ee5b73; --td-tab-item-active-color: #fff; --td-tab-item-color: #795348; --td-tab-item-height: 84rpx; --td-tab-item-tag-height: 60rpx; --td-tab-font: 28rpx / 40rpx -apple-system, BlinkMacSystemFont, sans-serif; }
.cookbook-filters { overflow: hidden; border-radius: 22rpx; --td-collapse-panel-bg-color: #f9f3e9; --td-collapse-header-text-color: #806c60; --td-collapse-horizontal-padding: 18rpx; --td-collapse-header-height: 64rpx; --td-collapse-content-padding: 0; --td-collapse-title-font: 25rpx / 38rpx -apple-system, BlinkMacSystemFont, sans-serif; --td-collapse-extra-font: 24rpx / 38rpx -apple-system, BlinkMacSystemFont, sans-serif; --td-collapse-border-color: transparent; }
.cookbook-list-heading { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; padding: 12rpx 0; --td-button-small-height: 60rpx; --td-button-small-font-size: 25rpx; }
.cookbook-count { font-family: PocketBrush, 'Kaiti SC', 'PingFang SC', sans-serif; color: #543a2e; font-size: 34rpx; line-height: 1.4; font-weight: 600; }
.cookbook-list { display: flex; flex-direction: column; }

.cookbook-add {margin-left:auto;flex:none;}
.cookbook-social {overflow:hidden;margin-bottom:20rpx;--td-cell-bg-color:#fffdf8;}
