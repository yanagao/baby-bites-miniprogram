.recipes-page {
  --td-brand-color: #0071e3;
  --td-brand-color-light: #eaf3ff;
  --td-button-medium-height: 88rpx;
  --td-button-medium-font: 600 28rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
.storage-warning { padding: 22rpx; margin-bottom: 24rpx; border-radius: 18rpx; background: #fff5df; color: #785b25; font-size: 25rpx; line-height: 1.6; }
.recipe-search-host {
  display: block;
  --td-search-height: 92rpx;
  --td-search-bg-color: #fff;
  --td-search-font: 29rpx / 44rpx -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-search-text-color: #1d2b3a;
  --td-search-placeholder-color: #94a0b2;
  --td-search-icon-color: #64748b;
  --td-search-icon-size: 40rpx;
  --td-search-clear-icon-size: 36rpx;
}
.recipe-search-box { border-color: #e4eaf2 !important; }
.category-filter { margin: 20rpx 0; }
.filter-tabs-host {
  display: block;
  --td-tab-nav-bg-color: transparent;
  --td-tab-item-height: 88rpx;
  --td-tab-item-tag-height: 72rpx;
  --td-tab-item-tag-bg: transparent;
  --td-tab-item-tag-active-bg: #eaf3ff;
  --td-tab-item-color: #64748b;
  --td-tab-item-active-color: #0071e3;
  --td-tab-font: 27rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-spacer: 8rpx;
  --td-spacer-2: 14rpx;
}
.filter-tab-item { flex: 1 1 0 !important; min-width: 0; padding: 0 4rpx !important; }
.recipe-filters { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid #e4eaf2; }
.picker-button { display: flex; align-items: center; min-height: 80rpx; padding: 0 20rpx; background: #fff; border: 1rpx solid #e4eaf2; border-radius: 18rpx; font-size: 26rpx; color: #536b88; }
.picker-arrow { margin-left: 18rpx; transform: rotate(90deg); }
.favorites-filter { display: flex; align-items: center; font-size: 25rpx; color: #64748b; }
.filter-switch-host { display: block; flex-shrink: 0; margin-left: 18rpx; }
.switch-hit-area { min-height: 88rpx; }
.results-heading { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 0 16rpx; }
.result-count { font-size: 24rpx; color: #64748b; }
.sort-picker { display: flex; align-items: center; min-height: 74rpx; font-size: 24rpx; color: #64748b; }
.sort-arrow { margin-left: 12rpx; transform: rotate(90deg); }
.recipe-list { gap: 0; }
.recipe-item { display: block; margin-bottom: 20rpx; }
.empty-host { display: block; margin-top: 20rpx; --td-empty-description-margin-top: 18rpx; --td-empty-action-margin-top: 28rpx; }
.empty-surface { padding: 64rpx 28rpx; border: 1rpx solid #e4eaf2; border-radius: 28rpx; background: #fff; }
.empty-heading { font-size: 32rpx; font-weight: 600; color: #1d2b3a; line-height: 1.5; }
.empty-description { margin-top: 16rpx; font-size: 26rpx; color: #64748b; line-height: 1.6; }
.empty-action { width: 440rpx; max-width: 100%; }
