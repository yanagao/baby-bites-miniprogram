.records-page { padding-top: 8rpx; }
.journal-heading { display: flex; align-items: center; justify-content: space-between; min-height: 172rpx; }
.journal-title { font-size: 45rpx; letter-spacing: -1rpx; white-space: nowrap; }
.journal-subtitle { margin-top: 14rpx; font-size: 23rpx; color: #8b766b; }
.journal-mascot { width: 144rpx; height: 160rpx; flex-shrink: 0; }
.weekly-summary { display: flex; align-items: center; padding: 29rpx 22rpx; border: 1rpx solid #ffe59a; border-radius: 36rpx; background: #fff0b9; }
.summary-item { flex: 1; text-align: center; }
.summary-value { font-size: 58rpx; font-weight: 800; line-height: 1.25; color: #3b241f; }
.summary-unit { margin-left: 7rpx; font-size: 24rpx; font-weight: 500; }
.summary-label { margin-top: 7rpx; font-size: 26rpx; color: #574038; }
.summary-divider { width: 2rpx; height: 76rpx; background: #e5cb84; }
.calendar-heading { margin-top: 23rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-arrow { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 76rpx; margin: 0; padding: 0; color: #3b241f; background: transparent; }
.calendar-arrow::after, .day-button::after, .rating-filter::after, .journal-card::after, .back-today::after, .empty-link::after, .picker-close::after, .picker-recipe::after, .picker-add-recipe::after { border: none; }
.calendar-arrow-disabled { opacity: .28; }
.calendar-month { font-size: 32rpx; font-weight: 700; }
.week-strip { display: flex; gap: 9rpx; }
.day-button { flex: 1; min-width: 0; height: 107rpx; margin: 0; padding: 12rpx 0 7rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 24rpx; background: #f1ede4; color: #3b241f; line-height: 1.3; }
.day-weekday { font-size: 20rpx; opacity: .65; }
.day-number { margin-top: 2rpx; font-size: 31rpx; font-weight: 600; }
.day-dot { width: 7rpx; height: 7rpx; margin-top: 6rpx; border-radius: 50%; background: transparent; }
.day-dot-visible { background: #ee5c72; }
.day-selected { background: #ee5c72; color: #fff; box-shadow: 0 5rpx 0 #f9d4d7; }
.day-selected .day-dot-visible { background: #fff; }
.day-selected .day-weekday { opacity: 1; }
.day-future { opacity: .42; }
.selected-date-row { display: flex; align-items: center; gap: 16rpx; min-height: 94rpx; margin-top: 13rpx; }
.selected-date { font-size: 35rpx; font-weight: 800; }
.today-label { padding: 5rpx 16rpx; border-radius: 30rpx; background: #ffe2d9; color: #d84556; font-size: 25rpx; font-weight: 700; }
.back-today { margin: 0 0 0 auto; padding: 4rpx 0; background: transparent; color: #dc5368; font-size: 24rpx; line-height: 2; }
.rating-filters { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.rating-filter { flex: 1; min-width: 0; min-height: 72rpx; padding: 14rpx 0; margin: 0; line-height: 1.6; border-radius: 30rpx; background: #f4eee4; color: #8b766b; font-size: 25rpx; }
.rating-filter-active { background: #ffe2e3; color: #d84556; font-weight: 700; }
.journal-list { display: flex; flex-direction: column; gap: 21rpx; }
.journal-card { display: flex; align-items: flex-start; width: 100%; margin: 0; padding: 23rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 5rpx 19rpx #69522d08; color: #3b241f; line-height: 1.45; text-align: left; }
.journal-photo { width: 164rpx; height: 164rpx; flex-shrink: 0; border-radius: 23rpx; background: #fff3d9; }
.journal-photo-empty { display: flex; align-items: center; justify-content: center; color: #ca9d65; }
.journal-content { flex: 1; min-width: 0; padding-left: 22rpx; }
.journal-card-header { display: flex; align-items: flex-start; gap: 14rpx; }
.journal-recipe-name { flex: 1; font-size: 30rpx; font-weight: 700; }
.journal-card-header > t-icon { margin-top: 5rpx; color: #b8a79a; }
.journal-tags { display: flex; align-items: center; gap: 9rpx; flex-wrap: wrap; margin-top: 14rpx; }
.journal-rating, .journal-portion { display: inline-flex; align-items: center; gap: 6rpx; border-radius: 21rpx; padding: 5rpx 11rpx; font-size: 22rpx; white-space: nowrap; }
.journal-rating-3 { background: #ffe0e2; color: #d43c56; }
.journal-rating-2 { background: #e2efff; color: #4d718c; }
.journal-rating-1 { background: #f4e9d9; color: #9a7345; }
.journal-portion { background: #eaf5df; color: #547a42; }
.journal-note { margin-top: 14rpx; color: #8b766b; font-size: 24rpx; white-space: pre-wrap; overflow-wrap: break-word; }
.journal-note-empty { color: #b7a89e; font-size: 22rpx; }
.journal-add { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 27rpx; }
.journal-empty { padding: 35rpx 18rpx 32rpx; text-align: center; border-radius: 32rpx; background: #fff; color: #d8b67d; }
.empty-title { margin-top: 16rpx; font-size: 28rpx; font-weight: 600; color: #70594b; }
.empty-description { margin-top: 10rpx; font-size: 23rpx; line-height: 1.7; color: #9e8b7c; }
.empty-actions { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin-top: 14rpx; }
.empty-link { margin: 0; padding: 10rpx 4rpx; font-size: 23rpx; line-height: 1.5; color: #d85268; background: transparent; }
.recipe-picker { padding: 32rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); background: #fffaf0; border-radius: 36rpx 36rpx 0 0; color: #3b241f; }
.recipe-picker-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22rpx; }
.recipe-picker-title { font-size: 36rpx; font-weight: 700; }
.recipe-picker-date { margin-top: 8rpx; color: #947c6d; font-size: 24rpx; }
.picker-close { width: 70rpx; height: 70rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f2eadd; color: #947c6d; }
.recipe-picker-list { height: 54vh; }
.recipe-picker-list-empty { height: 130rpx; }
.picker-recipe { display: flex; align-items: center; width: 100%; margin: 0 0 14rpx; padding: 16rpx; border-radius: 22rpx; text-align: left; color: #3b241f; line-height: 1.4; background: #fff; }
.picker-photo { width: 92rpx; height: 92rpx; border-radius: 17rpx; flex-shrink: 0; }
.picker-photo-empty { display: flex; align-items: center; justify-content: center; background: #fff3d9; color: #bd925e; }
.picker-recipe-content { flex: 1; min-width: 0; padding: 0 20rpx; }
.picker-recipe-name { font-size: 29rpx; font-weight: 600; }
.picker-recipe-description { margin-top: 6rpx; color: #9e8b7c; font-size: 23rpx; }
.picker-empty { padding: 40rpx 18rpx; text-align: center; color: #947c6d; font-size: 28rpx; }
.picker-add-recipe { margin: 18rpx 0 0; padding: 17rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 25rpx; background: #ffe5e5; color: #d84556; font-size: 28rpx; }

.journal-recipe-name,.picker-recipe-name {min-width:0;overflow-wrap:anywhere;}
