.records-page { padding: 8rpx 26rpx 28rpx; }
.journal-heading { display: flex; align-items: center; justify-content: space-between; min-height: 118rpx; }
.journal-title { font-size:var(--font-page-title); letter-spacing: 0; line-height: 1.45; }
.journal-subtitle { margin-top: 8rpx; font-size:var(--font-secondary); color: #82969a; line-height:var(--line-height-body);}
.journal-mascot { width: 104rpx; height: 114rpx; flex-shrink: 0; }
.weekly-summary { display: flex; align-items: center; padding: 20rpx; border: 1rpx solid #e2edf0; border-radius: 20rpx; background: #eff8f8; }
.summary-item { flex: 1; text-align: center; }
.summary-value { font-size:var(--font-page-title); font-weight: 600; line-height: 1.25; color: #345158; }
.summary-unit { margin-left: 7rpx; font-size:var(--font-caption); font-weight: 400; line-height:var(--line-height-body);}
.summary-label { margin-top: 7rpx; font-size:var(--font-secondary); color: #82969a; line-height:var(--line-height-body);}
.summary-divider { width: 1rpx; height: 56rpx; background: #cfdfeb; }
.calendar-heading { margin-top: 20rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-arrow { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; color: #345158; background: transparent; }
.calendar-arrow::after, .day-button::after, .rating-filter::after, .journal-card::after, .back-today::after, .empty-link::after, .picker-close::after, .picker-recipe::after, .picker-add-recipe::after { border: none; }
.calendar-arrow-disabled { opacity: .28; }
.calendar-month { font-size:var(--font-section-title); font-weight: 600; line-height:1.4;}
.week-strip { display: flex; gap: 9rpx; }
.day-button { flex: 1; min-width: 0; height: 128rpx; margin: 0; padding: 12rpx 0 7rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 18rpx; background: #eff8f8; color: #345158; line-height: 1.3; }
.day-weekday { font-size:var(--font-caption); opacity: .65; line-height:var(--line-height-body);}
.day-number { margin-top: 2rpx; font-size:var(--font-body); font-weight: 600; line-height:var(--line-height-body);}
.day-dot { width: 7rpx; height: 7rpx; margin-top: 6rpx; border-radius: 50%; background: transparent; }
.day-dot-visible { background: #55bba4; }
.day-selected { background: #55bba4; color: #153f37; }
.day-selected .day-dot-visible { background: #153f37; }
.day-selected .day-weekday { opacity: 1; line-height:var(--line-height-body);}
.day-future { opacity: .42; }
.selected-date-row { display: flex; align-items: center; gap: 16rpx; min-height: 80rpx; margin-top: 12rpx; }
.selected-date { font-size:var(--font-section-title); font-weight: 600; line-height:1.4;}
.today-label { padding: 4rpx 12rpx; border-radius: 12rpx; background: #eff8f8; color: #439e86; font-size:var(--font-caption); font-weight: 400; line-height:var(--line-height-body);}
.back-today { margin: 0 0 0 auto; padding: 4rpx 0; background: transparent; color: #439e86; font-size:var(--font-secondary); line-height:var(--line-height-body); }
.rating-filters { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.rating-filter { flex: 1; min-width: 0; min-height: 58rpx; padding: 11rpx 0; margin: 0; line-height:var(--line-height-body); border-radius: 18rpx; background: #eff8f8; color: #82969a; font-size:var(--font-secondary); }
.rating-filter-active { background: #eff8f8; color: #439e86; font-weight: 500; }
.journal-list { display: flex; flex-direction: column; gap: 18rpx; }
.journal-card { display: flex; align-items: flex-start; width: 100%; margin: 0; padding: 18rpx; border-radius: 20rpx; background: #eff8f8; border: 1rpx solid #e2edf0; color: #345158; line-height: 1.45; text-align: left; }
.journal-photo { width: 128rpx; height: 128rpx; flex-shrink: 0; border-radius: 16rpx; background: #eff8f8; }
.journal-photo-empty { display: flex; align-items: center; justify-content: center; color: #73c6e8; }
.journal-content { flex: 1; min-width: 0; padding-left: 18rpx; }
.journal-card-header { display: flex; align-items: flex-start; gap: 14rpx; }
.journal-recipe-name { flex: 1; font-size:var(--font-card-title); font-weight: 600; line-height:1.4;}
.journal-card-header > t-icon { margin-top: 5rpx; color: #9aadb1; }
.journal-tags { display: flex; align-items: center; gap: 9rpx; flex-wrap: wrap; margin-top: 10rpx; }
.journal-rating, .journal-portion { display: inline-flex; align-items: center; gap: 6rpx; border-radius: 10rpx; padding: 4rpx 9rpx; font-size:var(--font-caption); white-space: nowrap; line-height:var(--line-height-body);}
.journal-rating-3 { background: #fff1b8; color: #b38b4f; }
.journal-rating-2 { background: #eff8f8; color: #607d83; }
.journal-rating-1 { background: #eff8f8; color: #82969a; }
.journal-portion { background: #eff8f8; color: #439e86; }
.journal-note { margin-top: 10rpx; color: #82969a; font-size:var(--font-body); white-space: pre-wrap; overflow-wrap: break-word; line-height:var(--line-height-body);}
.journal-note-empty { color: #9aadb1; font-size:var(--font-secondary); line-height:var(--line-height-body);}
.journal-empty { padding: 30rpx 18rpx; text-align: center; border-radius: 20rpx; background: #ffffff; color: #73c6e8; }
.empty-title { margin-top: 16rpx; font-size:var(--font-card-title); font-weight: 600; color: #607d83; line-height:1.4;}
.empty-description { margin-top: 10rpx; font-size:var(--font-secondary); line-height:var(--line-height-body); color: #82969a; }
.empty-actions { display: flex; flex-wrap:wrap; align-items: center; justify-content: center; gap: 24rpx; margin-top: 10rpx; }
.empty-link { margin: 0; padding: 10rpx 4rpx; font-size:var(--font-secondary); line-height:var(--line-height-body); color: #439e86; background: transparent; }
.recipe-picker { padding: 26rpx 26rpx calc(26rpx + env(safe-area-inset-bottom)); background: #ffffff; border-radius: 28rpx 28rpx 0 0; color: #345158; }
.recipe-picker-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22rpx; }
.recipe-picker-title { font-size:var(--font-section-title); font-weight: 600; line-height:1.4;}
.recipe-picker-date { margin-top: 8rpx; color: #82969a; font-size:var(--font-secondary); line-height:var(--line-height-body);}
.picker-close { width: 60rpx; height: 60rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #eff8f8; color: #82969a; }
.recipe-picker-list { height: 54vh; }
.recipe-picker-list-empty { height: 130rpx; }
.picker-recipe { display: flex; align-items: center; width: 100%; margin: 0 0 14rpx; padding: 16rpx; border-radius: 22rpx; text-align: left; color: #345158; line-height:var(--line-height-body); background: #eff8f8; }
.picker-photo { width: 92rpx; height: 92rpx; border-radius: 17rpx; flex-shrink: 0; }
.picker-photo-empty { display: flex; align-items: center; justify-content: center; background: #eff8f8; color: #73c6e8; }
.picker-recipe-content { flex: 1; min-width: 0; padding: 0 20rpx; }
.picker-recipe-name { font-size:var(--font-card-title); font-weight: 600; line-height:1.4;}
.picker-recipe-description { margin-top: 6rpx; color: #82969a; font-size:var(--font-secondary); line-height:var(--line-height-body);}
.picker-empty { padding: 40rpx 18rpx; text-align: center; color: #82969a; font-size:var(--font-body); line-height:var(--line-height-body);}
.picker-add-recipe { margin: 18rpx 0 0; padding: 16rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border-radius: 20rpx; background: #eff8f8; color: #439e86; font-size:var(--font-body); line-height:var(--line-height-body);}

.journal-recipe-name,.picker-recipe-name {min-width:0;overflow-wrap:anywhere;line-height:1.4;}

.calendar-month {display:flex;align-items:center;gap:10rpx;font-size:var(--font-body);}
.day-today {font-size:20rpx;line-height:1.3;}
.record-day-add,.meal-pick-link,.meal-day-toolbar button {display:flex;align-items:center;justify-content:center;gap:8rpx;padding:8rpx 0;margin:0 0 0 auto;background:transparent;color:#276e60;font-size:var(--font-secondary);line-height:1.5;}
.record-day-add::after,.meal-pick-link::after,.meal-card-actions button::after,.meal-choice::after,.meal-day-toolbar button::after {border:0;}
.record-day-add[disabled] {color:#a7b7bb;}
.meal-day-hint {padding:20rpx 24rpx;margin:0 0 20rpx;border-radius:20rpx;background:#eff8f8;font-size:var(--font-secondary);color:#577479;text-align:center;}
.meal-hint-title {font-size:var(--font-body);font-weight:600;margin-bottom:4rpx;color:#345158;}
.meal-day-toolbar {display:flex;gap:16rpx;align-items:center;margin:0 0 16rpx;font-size:var(--font-caption);color:#82969a;}
.meal-empty-slot,.meal-plan-card {padding:20rpx 22rpx;margin-bottom:18rpx;border:2rpx solid #d5e9ec;border-radius:20rpx;background:#eff8f8;}
.meal-empty-slot {display:flex;align-items:center;gap:18rpx;}
.meal-slot-icon {display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex:none;background:#fff;border-radius:50%;color:#577479;}
.meal-empty-copy {flex:1;min-width:0;}
.meal-slot-title {font-size:var(--font-body);line-height:1.5;font-weight:600;}
.meal-card-main {display:flex;align-items:flex-start;gap:20rpx;}
.meal-card-photo {width:128rpx;height:128rpx;flex:none;border-radius:16rpx;background:#fff;}
.meal-photo-empty {display:flex;align-items:center;justify-content:center;color:#73c6e8;}
.meal-card-copy {flex:1;min-width:0;}
.meal-card-heading {display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-bottom:6rpx;}
.meal-slot-tag,.meal-done-tag {padding:1rpx 12rpx;border-radius:999rpx;font-size:var(--font-caption);line-height:1.5;}
.meal-slot-tag {background:#fff;color:#577479;}
.meal-done-tag {display:flex;align-items:center;gap:4rpx;background:#55bba4;color:#153f37;}
.meal-card-name {font-size:var(--font-card-title);font-weight:600;line-height:1.4;overflow-wrap:anywhere;}
.meal-card-meta {margin-top:6rpx;font-size:var(--font-secondary);color:#577479;line-height:1.5;}
.meal-allergy {margin-top:6rpx;font-size:var(--font-caption);line-height:1.5;color:#aa6a45;overflow-wrap:anywhere;}
.meal-card-actions {display:flex;gap:12rpx;margin-top:18rpx;}
.meal-card-actions button {flex:1;min-width:0;margin:0;padding:9rpx 8rpx;border-radius:999rpx;border:1rpx solid #d5e9ec;background:#fff;color:#276e60;font-size:var(--font-secondary);line-height:1.5;}
.meal-card-actions .meal-done-button {background:#55bba4;border-color:#55bba4;color:#153f37;}
.meal-card-actions button[disabled] {color:#82969a;background:#e1eeee;border-color:#e1eeee;}
.meal-recorder {margin-top:12rpx;font-size:var(--font-caption);color:#82969a;text-align:right;}
.meal-plan-footnote {margin:14rpx 0 20rpx;color:#82969a;font-size:var(--font-caption);line-height:1.6;}
.meal-family-note {display:flex;align-items:center;gap:12rpx;margin:22rpx 0;padding:18rpx;border-radius:16rpx;background:#eff8f8;color:#577479;font-size:var(--font-caption);}
.meal-history-heading {display:flex;align-items:center;justify-content:space-between;margin:32rpx 0 14rpx;}
.weekly-summary {gap:24rpx;justify-content:space-between;font-size:var(--font-caption);color:#82969a;}
.meal-choice-row {display:flex;gap:14rpx;margin:18rpx 0 26rpx;}
.meal-choice {flex:1;min-width:0;margin:0;padding:18rpx 8rpx;border:2rpx solid #d5e9ec;border-radius:18rpx;background:#eff8f8;color:#577479;font-size:var(--font-secondary);line-height:1.5;}
.meal-choice-selected {border-color:#55bba4;background:#55bba4;color:#153f37;}
.meal-picker-search {height:76rpx;box-sizing:border-box;padding:14rpx 22rpx;margin-bottom:18rpx;border:2rpx solid #d5e9ec;border-radius:18rpx;background:#eff8f8;font-size:var(--font-secondary);}
.recipe-picker-list {height:40vh;}
.picker-recipe {border:2rpx solid transparent;}
.picker-recipe-selected {border-color:#55bba4;}
.meal-page-error {margin:14rpx 0;color:#b36f55;font-size:var(--font-secondary);line-height:1.6;}
.completion-recipe {display:flex;align-items:center;gap:20rpx;padding:18rpx;border-radius:18rpx;background:#eff8f8;}
.completion-recipe image {width:116rpx;height:116rpx;flex:none;border-radius:14rpx;}
.completion-recipe > view {flex:1;min-width:0;}
.completion-sheet {max-height:88vh;overflow-y:auto;}
