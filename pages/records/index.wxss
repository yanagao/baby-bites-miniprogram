.records-page {
  --td-brand-color: #0071e3;
  --td-brand-color-light: #eaf3ff;
  --td-button-medium-height: 88rpx;
  --td-button-medium-font: 600 28rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
.storage-warning { padding: 22rpx; margin-bottom: 24rpx; border-radius: 18rpx; background: #fff5df; color: #785b25; font-size: 25rpx; line-height: 1.6; }
.record-overview { display: flex; padding: 34rpx 0; background: #fff; border: 1rpx solid #e4eaf2; border-radius: 26rpx; margin-bottom: 24rpx; }
.overview-item { display: flex; flex-direction: column; align-items: center; flex: 1; border-right: 1rpx solid #eef1f6; }
.overview-item:last-child { border-right: 0; }
.overview-value { display: flex; align-items: baseline; justify-content: center; white-space: nowrap; }
.overview-number { font-size: 46rpx; font-weight: 650; line-height: 1.1; letter-spacing: -1rpx; color: #405875; }
.overview-unit { font-size: 24rpx; font-weight: 400; line-height: 1.1; color: #64748b; margin-left: 6rpx; }
.overview-label { font-size: 24rpx; color: #64748b; margin-top: 13rpx; }
.record-filter { margin-bottom: 24rpx; }
.filter-tabs-host {
  display: block;
  --td-tab-nav-bg-color: transparent;
  --td-tab-item-height: 88rpx;
  --td-tab-item-tag-height: 72rpx;
  --td-tab-item-tag-bg: transparent;
  --td-tab-item-tag-active-bg: #eaf3ff;
  --td-tab-item-color: #64748b;
  --td-tab-item-active-color: #0071e3;
  --td-tab-font: 25rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-spacer: 8rpx;
  --td-spacer-2: 12rpx;
}
.filter-tab-item { flex: 1 1 0 !important; min-width: 0; padding: 0 4rpx !important; }
.log-card { padding: 16rpx 28rpx 28rpx; margin-bottom: 20rpx; }
.log-topline { display: flex; align-items: center; justify-content: space-between; }
.log-date { font-size: 24rpx; color: #7c8ca1; }
.delete-host {
  display: block;
  margin-right: -12rpx;
  --td-button-small-height: 72rpx;
  --td-button-small-font: 400 24rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-button-default-color: #7c8ca1;
}
.delete-control { padding: 0 12rpx !important; }
.recipe-entry-host {
  display: block;
  --td-cell-vertical-padding: 8rpx;
  --td-cell-horizontal-padding: 0;
  --td-cell-title-font: 600 32rpx / 1.5 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-cell-title-color: #1d2b3a;
  --td-cell-right-icon-color: #64748b;
}
.recipe-entry { min-height: 80rpx; }
.log-feedback { display: flex; align-items: center; flex-wrap: wrap; margin-top: 10rpx; font-size: 25rpx; color: #536b88; }
.feedback-rating { margin-left: 10rpx; }
.portion { color: #7c8ca1; margin-left: 12rpx; }
.log-note { margin-top: 18rpx; font-size: 27rpx; line-height: 1.7; color: #536b88; white-space: pre-wrap; word-break: break-all; }
.empty-host { display: block; margin-top: 20rpx; --td-empty-description-margin-top: 18rpx; --td-empty-action-margin-top: 28rpx; }
.empty-surface { padding: 64rpx 28rpx; border: 1rpx solid #e4eaf2; border-radius: 28rpx; background: #fff; }
.empty-heading { font-size: 32rpx; font-weight: 600; color: #1d2b3a; line-height: 1.5; }
.empty-description { margin-top: 16rpx; font-size: 26rpx; color: #64748b; line-height: 1.6; }
.empty-action { width: 440rpx; max-width: 100%; }
