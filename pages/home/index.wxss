.home-page {padding-top:10rpx;}
.home-intro {display:flex;align-items:center;justify-content:space-between;min-height:210rpx;position:relative;}
.home-intro-copy {flex:1;min-width:0;}
.home-greeting {overflow-wrap:anywhere;word-break:break-word;}
.home-intro .page-title {font-size:62rpx;line-height:1.17;letter-spacing:1rpx;}
.intro-mascot {width:226rpx;height:226rpx;flex:none;margin-right:-15rpx;transform:rotate(6deg);}
.intro-subtitle {font-size:26rpx;color:#877267;margin-top:12rpx;letter-spacing:2rpx;}
.category-scroll {width:100%;margin-top:16rpx;white-space:nowrap;}
.category-pills {display:inline-flex;gap:12rpx;padding:2rpx 4rpx;vertical-align:top;}
.category-pill {flex:none;min-width:96rpx;margin:0;padding:0 24rpx;line-height:64rpx;border-radius:40rpx;font-size:27rpx;color:#5a3e35;background:#ffebe7;}
.category-active {color:#fff;background:#ef5b73;font-weight:600;box-shadow:inset 0 0 0 2rpx #fff,0 0 0 1rpx #ef5b73;}
.skip-row {display:flex;align-items:center;justify-content:space-between;min-height:78rpx;font-size:26rpx;}
.inspiration-card {position:relative;padding:22rpx;background:#fff0b8;border:2rpx solid #ffe3a0;border-radius:48rpx 42rpx 36rpx 44rpx;}
.inspiration-card::before {content:'';position:absolute;pointer-events:none;inset:10rpx;border:2rpx dashed #efd18c;border-radius:36rpx;}
.inspiration-label {position:absolute;z-index:2;top:13rpx;left:28rpx;transform:rotate(-10deg);background:#ffd4d6;border:3rpx solid #fff5e7;box-shadow:0 2rpx 4rpx #dabd8a;padding:10rpx 24rpx;color:#ba4057;border-radius:16rpx;font-size:33rpx;}
.hero-photo {display:block;width:100%;height:330rpx;border-radius:30rpx;}
.hero-illustration {display:flex;align-items:center;justify-content:center;flex-direction:column;height:330rpx;background:#fcf7dd;border-radius:30rpx;color:#a28558;font-size:24rpx;}
.dish-info {position:relative;z-index:1;margin:-12rpx 16rpx 0;padding:12rpx 8rpx 16rpx;background:#fffaf1;border-radius:44rpx 44rpx 20rpx 20rpx;text-align:center;}
.dish-title {font-size:49rpx;line-height:1.25;color:#432820;}
.dish-metadata {display:flex;justify-content:center;gap:20rpx;margin-top:12rpx;}
.dish-metadata>view {display:flex;align-items:center;gap:8rpx;background:#ffede6;border-radius:30rpx;padding:4rpx 16rpx;font-size:24rpx;line-height:36rpx;}
.hero-actions {position:relative;z-index:1;display:flex;flex-direction:column;gap:14rpx;margin-top:12rpx;--td-button-large-height:96rpx;--td-button-medium-height:84rpx;--td-button-primary-outline-color:#d94b64;--td-button-primary-outline-border-color:#db5b63;--td-button-primary-outline-bg-color:#fffdf7;}
.draw-ready {text-align:center;padding:24rpx 0 10rpx;}
.draw-ready image {display:block;width:250rpx;height:250rpx;margin:0 auto;}
.ready-title {font-size:45rpx;line-height:1.3;}.ready-subtitle {font-size:25rpx;line-height:1.6;color:#9b805d;margin:12rpx 0 10rpx;}
.draw-empty {text-align:center;padding:25rpx 0 5rpx;position:relative;}
.draw-empty image {width:200rpx;height:200rpx;}
.pantry-banner {display:flex;align-items:center;gap:6rpx;background:#eaf4db;border-radius:28rpx;margin-top:20rpx;padding:18rpx 20rpx;min-height:132rpx;}
.pantry-banner-text {flex:1;min-width:0;}.pantry-banner-text>view {font-size:34rpx;white-space:nowrap;}.pantry-banner-text>text {display:block;margin-top:10rpx;font-size:24rpx;line-height:1.5;color:#63764f;}
.banner-foods {display:flex;align-items:center;}.banner-foods food-art+food-art {margin-left:-25rpx;}
.recent-section {margin-top:48rpx;}.recent-section>.section-title {margin-bottom:16rpx;}.recent-meal {display:flex;flex-wrap:wrap;align-items:center;gap:6rpx 10rpx;padding:20rpx 0;border-bottom:1rpx solid #eee4d5;font-size:27rpx;}.recent-meal>text:first-child {flex:1;}.recent-meal .muted {font-size:23rpx;}
.home-tools {display:flex;justify-content:space-between;margin-top:16rpx;}.home-tools button {margin:0;padding:10rpx 0;background:transparent;color:#9b8473;font-size:23rpx;line-height:44rpx;}

.category-pill::after,.home-tools button::after {border:0;}
