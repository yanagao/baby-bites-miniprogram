.profile-top {position:relative;background:#ffffff;overflow:hidden;--td-navbar-bg-color:transparent;}
.profile-cover {height:142rpx;position:relative;overflow:hidden;background:#eff8f8;}
.cover-sun {position:absolute;width:96rpx;height:96rpx;background:#fff1b8;border-radius:50%;left:calc(50% - 48rpx);top:-28rpx;opacity:.55;}
.cover-hill {position:absolute;bottom:-88rpx;width:530rpx;height:176rpx;border-radius:50%;background:rgba(85,187,164,.18);}
.cover-hill-left {left:-140rpx;transform:rotate(10deg);}.cover-hill-right {right:-170rpx;bottom:-74rpx;background:rgba(85,187,164,.10);transform:rotate(-14deg);}
.cover-food {position:absolute;bottom:12rpx;opacity:.42;}.cover-food-one {left:38rpx;transform:rotate(-12deg);}.cover-food-two {left:165rpx;bottom:23rpx;transform:rotate(15deg);}.cover-food-three {right:44rpx;transform:rotate(8deg);}
.profile-toolbar {position:absolute;right:28rpx;bottom:76rpx;display:flex;gap:14rpx;}
.profile-tool {display:flex;align-items:center;justify-content:center;margin:0;width:52rpx;height:52rpx;padding:0;border-radius:50%;background:rgba(255,255,255,.94);color:#577479;}.profile-tool[disabled] {color:#a8b9bc;background:rgba(255,255,255,.7);}
.profile-tool::after,.profile-avatar-button::after,.profile-stat::after,.profile-content-tab::after,.profile-filter::after,.profile-record-heading button::after,.profile-log::after,.profile-edit-heading button::after,.profile-status button::after {border:0;}
.profile-sheet {position:relative;z-index:1;margin-top:-26rpx;padding:0 28rpx 32rpx;background:#ffffff;border-radius:50% 50% 0 0 / 48rpx 48rpx 0 0;min-height:60vh;}
.profile-identity {text-align:center;padding-top:1rpx;}
.profile-avatar-button {margin:-60rpx auto 0;width:116rpx;height:116rpx;display:flex;align-items:center;justify-content:center;padding:10rpx;border-radius:50%;background:#ffffff;border:5rpx solid #ffffff;box-shadow:0 2rpx 8rpx rgba(48,75,80,.04);}.profile-avatar {width:88rpx;height:100rpx;display:block;}
.profile-name {font-size:var(--font-card-title);font-weight:600;line-height:1.4;margin:10rpx 24rpx 0;color:#345158;overflow-wrap:anywhere;}
.profile-bio {font-size:var(--font-secondary);line-height:var(--line-height-body);margin:6rpx auto 0;max-width:570rpx;white-space:pre-wrap;overflow-wrap:anywhere;color:#82969a;}
.profile-primary {margin:12rpx auto 0;display:flex;justify-content:center;--td-button-small-height:72rpx;--td-button-small-font:500 var(--font-body) / var(--line-height-body) var(--td-font-family);--td-button-small-padding-horizontal:42rpx;}
.profile-baby-age {display:inline-flex;align-items:center;gap:4rpx;margin:3rpx auto 0;padding:5rpx 12rpx;border-radius:22rpx;background:transparent;color:#82969a;font-size:var(--font-secondary);line-height:var(--line-height-body);}
.profile-baby-age-edit {min-height:52rpx;}.profile-baby-age-edit::after {border:0;}.profile-baby-age-edit[disabled] {background:transparent;color:#a8b9bc;}
.profile-stats {display:flex;justify-content:center;margin:20rpx auto 12rpx;max-width:560rpx;gap:24rpx;}.profile-stat {display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;gap:2rpx;margin:0;padding:6rpx 0;background:transparent;font-size:var(--font-caption);color:#82969a;line-height:var(--line-height-body);}.profile-stats button.profile-stat[disabled] {background-color:transparent;color:#82969a;}.profile-stat-number {font-size:var(--font-card-title);line-height:1.45;color:#345158;font-weight:600;}
.profile-content-tabs {display:flex;justify-content:space-around;padding:0 4rpx;border-bottom:1rpx solid #e5eef0;}.profile-content-tab {position:relative;background:transparent;margin:0;padding:16rpx 30rpx 18rpx;line-height:1.4;font-size:var(--font-body);color:#82969a;border-radius:0;}.profile-content-tab-active {color:#345158;font-weight:600;}.profile-content-tab-active::before {content:'';position:absolute;bottom:0;left:calc(50% - 17rpx);width:34rpx;height:3rpx;background:#55bba4;border-radius:4rpx;}
.profile-visibility-tabs {display:flex;gap:14rpx;padding:18rpx 0;}.profile-filter {font-size:var(--font-secondary);color:#82969a;background:#eff8f8;padding:7rpx 22rpx;min-height:52rpx;line-height:1.4;border-radius:26rpx;margin:0;}.profile-filter-active {background:#55bba4;color:#153f37;}
.profile-recipe-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx 20rpx;margin-top:20rpx;}.profile-visibility-tabs + .profile-recipe-grid {margin-top:0;}
.profile-status {display:flex;gap:12rpx;align-items:center;justify-content:center;padding:10rpx 0;font-size:var(--font-secondary);}.profile-status button {background:transparent;color:#439e86;font-size:var(--font-secondary);line-height:var(--line-height-body);margin:0;padding:6rpx;flex:none;}
.profile-empty {display:flex;flex-direction:column;align-items:center;gap:14rpx;text-align:center;padding:34rpx 18rpx;color:#577479;font-size:var(--font-body);line-height:var(--line-height-body);}.profile-empty image {width:110rpx;height:126rpx;}.profile-empty .muted {font-size:var(--font-secondary);max-width:520rpx;}
.profile-state {padding:60rpx 26rpx;min-height:60vh;background:#ffffff;}.profile-more {padding:18rpx;text-align:center;}.profile-setup-note {font-size:var(--font-secondary);line-height:var(--line-height-body);color:#82969a;margin:12rpx 0;}
.profile-record-heading {display:flex;flex-wrap:wrap;gap:8rpx;align-items:center;justify-content:space-between;margin:18rpx 0 10rpx;}.profile-record-heading .muted {font-size:var(--font-caption);}.profile-record-heading button {display:flex;align-items:center;background:transparent;color:#439e86;font-size:var(--font-secondary);padding:8rpx 0;margin:0;line-height:var(--line-height-body);}
.profile-log {display:flex;align-items:center;gap:18rpx;text-align:left;width:100%;padding:16rpx 0;margin:0;background:transparent;border-bottom:1rpx solid #e5eef0;border-radius:0;line-height:var(--line-height-body);color:#345158;}.profile-log>image,.profile-log-art {width:100rpx;height:100rpx;flex:none;border-radius:16rpx;background:#eff8f8;}.profile-log-art {display:flex;align-items:center;justify-content:center;color:#8ca6ac;}.profile-log-copy {min-width:0;flex:1;}.profile-log-name {display:block;font-size:var(--font-card-title);font-weight:600;overflow-wrap:anywhere;}.profile-log-date,.profile-log-meta {font-size:var(--font-caption);color:#82969a;}.profile-log-meta {margin-top:4rpx;color:#439e86;}
.profile-edit {height:84vh;display:flex;flex-direction:column;overflow:hidden;background:#ffffff;border-radius:28rpx 28rpx 0 0;--td-input-bg-color:transparent;--td-textarea-background-color:transparent;--td-input-vertical-padding:20rpx 24rpx;--td-textarea-padding:20rpx 24rpx;--td-input-label-max-width:100%;--td-input-label-text-color:#577479;--td-textarea-label-color:#577479;--td-input-default-text-color:#345158;--td-textarea-text-color:#345158;--td-input-label-text-font:500 var(--font-secondary) / var(--line-height-body) var(--td-font-family);--td-input-placeholder-text-font:400 var(--font-secondary) / var(--line-height-body) var(--td-font-family);--td-font-size-base:var(--font-secondary);--td-font-body-large:400 var(--font-body) / var(--line-height-body) var(--td-font-family);--td-font-body-medium:400 var(--font-secondary) / var(--line-height-body) var(--td-font-family);--td-font-body-small:400 var(--font-caption) / var(--line-height-body) var(--td-font-family);}
.profile-edit-heading {flex:none;display:flex;align-items:center;justify-content:space-between;padding:24rpx 28rpx 20rpx;border-bottom:1rpx solid #e5eef0;}.profile-edit-heading .section-title {font-size:var(--font-section-title);color:#345158;}.profile-edit-heading button,.profile-share-heading button {background:#eff8f8;display:flex;flex:none;align-items:center;justify-content:center;width:58rpx;height:58rpx;margin:0;padding:0;border-radius:50%;color:#577479;}.profile-edit-heading button[disabled] {color:#a8b9bc;}
.profile-edit-scroll {flex:1;height:0;min-height:0;}.profile-edit-fields {padding:24rpx 28rpx 8rpx;}.profile-field-card {margin:0 0 20rpx;background:#eff8f8;border:2rpx solid #d5e9ec;border-radius:20rpx;overflow:hidden;}.profile-field-disabled {border-color:#e5eef0;--td-input-disabled-text-color:#82969a;--td-textarea-disabled-text-color:#82969a;}.profile-field-label {font-size:var(--font-secondary);line-height:var(--line-height-body);font-weight:500;color:#577479;}.profile-edit-note {font-size:var(--font-caption);line-height:var(--line-height-body);margin:0 4rpx 18rpx;}
.profile-edit-footer {flex:none;padding:20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e5eef0;background:#ffffff;}.profile-age-picker {display:block;}.profile-age-field {display:flex;flex-direction:column;gap:12rpx;padding:20rpx 24rpx;font-size:var(--font-body);line-height:var(--line-height-body);color:#345158;}.profile-age-value {display:flex;min-width:0;align-items:center;justify-content:space-between;gap:16rpx;color:#345158;}.profile-age-value.muted,.profile-field-disabled .profile-age-value {color:#82969a;}
.profile-birthday-meta {display:flex;align-items:flex-start;flex-direction:column;gap:6rpx;padding:0 24rpx 16rpx;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);}.profile-birthday-meta>text {overflow-wrap:anywhere;}.profile-birthday-meta>t-button {align-self:flex-end;}.profile-birthday-privacy {margin:-4rpx 4rpx 20rpx;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);}.profile-edit-offline {margin:0 4rpx 20rpx;font-size:var(--font-caption);line-height:var(--line-height-body);}.profile-edit-error {margin:0 0 16rpx;padding:12rpx 18rpx;border-radius:16rpx;background:#fff1b8;color:#345158;font-size:var(--font-secondary);line-height:var(--line-height-body);}
.profile-share {width:650rpx;max-width:calc(100vw - 48rpx);height:86vh;max-height:1110rpx;display:flex;flex-direction:column;overflow:hidden;background:#ffffff;border-radius:26rpx;}.profile-share-heading {flex:none;display:flex;align-items:center;justify-content:space-between;padding:20rpx 24rpx;color:#345158;font-size:var(--font-body);font-weight:600;line-height:var(--line-height-body);}.profile-share-heading button::after {border:0;}.profile-share-scroll {flex:1;height:0;min-height:0;}.profile-share-image {display:block;width:500rpx;max-width:calc(100% - 48rpx);margin:0 auto;border-radius:18rpx;}.profile-share-placeholder {display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;min-height:420rpx;margin:0 24rpx;padding:40rpx 20rpx;background:#eff8f8;border-radius:18rpx;text-align:center;}.profile-share-placeholder>image {width:120rpx;height:120rpx;}.profile-share-name {max-width:100%;overflow-wrap:anywhere;text-align:center;font-size:var(--font-card-title);font-weight:600;color:#345158;}.profile-share-placeholder .muted,.profile-share-note {font-size:var(--font-secondary);color:#82969a;line-height:var(--line-height-body);}.profile-share-note {margin:16rpx 28rpx;text-align:center;}.profile-share-actions {flex:none;display:flex;flex-direction:column;gap:4rpx;padding:18rpx 24rpx 16rpx;border-top:1rpx solid #e5eef0;--td-button-medium-height:88rpx;--td-button-medium-font:500 var(--font-body) / var(--line-height-body) var(--td-font-family);}.profile-share-canvas {position:fixed;left:-10000px;top:0;width:600px;height:860px;pointer-events:none;}
