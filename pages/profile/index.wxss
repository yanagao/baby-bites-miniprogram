.social-page {padding-bottom:calc(36rpx + env(safe-area-inset-bottom));}.social-state {padding:46rpx 28rpx;text-align:center;line-height:1.65;}.social-empty-title {font-size:31rpx;font-weight:600;margin-bottom:12rpx;}.social-empty-action {margin-top:24rpx;}.social-section-heading {display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:30rpx 0 18rpx;}.social-recipe {display:flex;align-items:center;gap:20rpx;padding:20rpx;margin-bottom:18rpx;}.social-photo {width:134rpx;height:134rpx;border-radius:20rpx;flex:none;display:block;background:#fff3d6;}.social-art {display:flex;align-items:center;justify-content:center;}.social-recipe-copy {flex:1;min-width:0;}.social-recipe-title {font-size:32rpx;font-weight:600;line-height:1.45;overflow-wrap:anywhere;}.social-meta {font-size:24rpx;color:#8d7c70;line-height:1.5;margin-top:5rpx;}.social-more {text-align:center;margin-top:12rpx;}.social-pressed {background:#fff4e7;}.profile-panel {padding:26rpx;}.profile-header {display:flex;align-items:center;gap:22rpx;}.profile-avatar {width:128rpx;height:146rpx;flex:none;}.profile-copy {min-width:0;flex:1;}.profile-name {font-size:45rpx;line-height:1.35;margin-bottom:8rpx;overflow-wrap:anywhere;}.profile-copy .muted {white-space:pre-wrap;overflow-wrap:anywhere;}.profile-actions {display:flex;justify-content:flex-end;flex-wrap:wrap;gap:16rpx;margin-top:24rpx;}.profile-note {margin-top:20rpx;font-size:24rpx;}.profile-edit {margin-top:20rpx;overflow:hidden;padding:0 0 24rpx;}.profile-edit .profile-note {padding:0 24rpx;}.profile-edit .profile-actions {padding:0 24rpx;}
