.social-tabs {padding:0 12rpx;--td-tab-nav-bg-color:transparent;--td-tab-item-height:88rpx;--td-tab-item-color:#82969a;--td-tab-item-active-color:#345158;--td-tab-track-color:#55bba4;--td-tab-track-thickness:3rpx;--td-tab-track-width:34rpx;--td-tab-border-color:#e5eef0;--td-tab-font:var(--font-body) / var(--line-height-body) var(--td-font-family);}
.feed-avatar {display:block;width:48rpx;height:48rpx;flex:none;border-radius:50%;background:#eff8f8;}
.person-avatar-image {display:block;width:64rpx;height:64rpx;}
.social-page {padding:20rpx 28rpx 30rpx;}
.social-state {padding:38rpx 24rpx;text-align:center;font-size:var(--font-body);line-height:var(--line-height-body);}.social-state .muted {font-size:var(--font-secondary);}.social-empty-title {font-size:var(--font-section-title);font-weight:600;line-height:1.45;margin-bottom:12rpx;color:#345158;}.social-empty-action {margin-top:20rpx;}
.social-recipe {display:flex;align-items:center;gap:18rpx;margin-bottom:16rpx;padding:20rpx;background:#eff8f8;}.social-photo {display:block;width:144rpx;height:144rpx;flex:none;border-radius:16rpx;}.social-art {display:flex;align-items:center;justify-content:center;background:#eff8f8;}.social-recipe-copy {flex:1;min-width:0;}.social-recipe-title {font-size:var(--font-card-title);line-height:1.45;font-weight:600;color:#345158;overflow-wrap:anywhere;}.social-recipe-copy>.muted {font-size:var(--font-caption);margin-top:6rpx;}.social-meta {font-size:var(--font-caption);color:#82969a;line-height:var(--line-height-body);margin-top:8rpx;}.social-recipe>t-icon {flex:none;color:#9bafb3;}.social-pressed {opacity:.78;}.social-more {padding:18rpx 0;text-align:center;}
.feed-card {margin-bottom:18rpx;overflow:hidden;background:#eff8f8;border:1rpx solid #e5eef0;border-radius:22rpx;box-shadow:none;}.feed-author {display:flex;align-items:center;gap:10rpx;padding:16rpx 20rpx;border-bottom:1rpx solid #e5eef0;color:#577479;font-size:var(--font-secondary);}.feed-author>text {flex:1;min-width:0;overflow-wrap:anywhere;}.feed-recipe {margin:0;}
.person-card {gap:14rpx;border-radius:20rpx;border:1rpx solid #e5eef0;box-shadow:none;--td-button-small-font:500 var(--font-body) / var(--line-height-body) var(--td-font-family);--td-button-small-height:72rpx;--td-button-small-padding-horizontal:22rpx;}
.person-open {display:flex;align-items:center;gap:16rpx;flex:1;min-width:0;border-radius:16rpx;}.person-avatar {width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;flex:none;background:#eff8f8;color:#73c6e8;border-radius:50%;}.person-card .social-recipe-title {font-size:var(--font-card-title);}
.person-bio {display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere;font-size:var(--font-secondary);line-height:var(--line-height-body);}.person-relationship {margin-top:5rpx;color:#439e86;font-size:var(--font-caption);line-height:var(--line-height-body);}.person-card>t-button {flex:none;}
.social-page>.profile-setup-note {margin:0 0 18rpx;font-size:var(--font-secondary);line-height:var(--line-height-body);color:#82969a;}
