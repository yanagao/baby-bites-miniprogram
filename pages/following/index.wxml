<t-navbar z-index="100" title="我的关注" placeholder left-arrow delta="{{0}}" bind:go-back="back" />
<t-tabs value="{{tab}}" bind:change="changeTab"><t-tab-panel value="recipes" label="关注的菜谱" /><t-tab-panel value="people" label="关注的人" /></t-tabs>
<view class="page-shell social-page">
  <view wx:if="{{loading}}" class="social-state muted">正在看看小厨房的新菜…</view>
  <t-empty wx:elif="{{error}}" icon="info-circle" description="{{error}}"><t-button slot="action" theme="primary" bind:tap="reload">重新加载</t-button></t-empty>
  <block wx:elif="{{tab === 'recipes'}}">
    <view wx:if="{{!recipes.length}}" class="panel social-state"><view class="social-empty-title">还没有关注的菜谱</view><view class="muted">打开好友分享的主页并关注，对方公开的食谱会出现在这里。</view><view class="social-empty-action"><t-button theme="primary" variant="outline" size="small" bind:tap="showPeople">查看关注的人</t-button></view></view>
    <view wx:for="{{recipes}}" wx:key="id" class="feed-card panel">
      <view class="feed-author" data-id="{{item.profileId}}" bindtap="openProfile" hover-class="social-pressed" aria-role="button"><t-icon name="user" size="30rpx" /><text>{{item.authorName}}</text><t-icon name="chevron-right" size="26rpx" /></view>
      <view class="social-recipe feed-recipe" data-id="{{item.id}}" bindtap="openRecipe" hover-class="social-pressed" aria-role="button" aria-label="{{'查看' + item.name}}"><image wx:if="{{item.photoURL}}" src="{{item.photoURL}}" class="social-photo" mode="aspectFill" data-index="{{index}}" binderror="photoError" /><view wx:else class="social-photo social-art"><food-art name="{{item.ingredients[0].name}}" size="100" /></view><view class="social-recipe-copy"><view class="social-recipe-title">{{item.name}}</view><view class="muted">{{item.category}}</view><view class="social-meta">{{item.minutes}} 分钟 · {{item.texture}}</view></view><t-icon name="chevron-right" size="32rpx" /></view>
    </view>
    <view wx:if="{{nextCursor}}" class="social-more"><t-button theme="primary" variant="text" loading="{{loadingMore}}" disabled="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </block>
  <block wx:else>
    <view wx:if="{{!profiles.length}}" class="panel social-state"><view class="social-empty-title">还没有关注的人</view><view class="muted">让好友把主页分享给你，打开后点「关注」。也可以把自己的主页分享给好友。</view><view class="social-empty-action"><t-button theme="primary" variant="outline" size="small" bind:tap="openMine">打开我的主页</t-button></view></view>
    <view wx:for="{{profiles}}" wx:key="id" class="social-recipe panel" data-id="{{item.id}}" bindtap="openProfile" hover-class="social-pressed" aria-role="button"><view class="person-avatar"><t-icon name="user" size="42rpx" /></view><view class="social-recipe-copy"><view class="social-recipe-title">{{item.name}}</view><view class="muted">{{item.bio || '看看 TA 的口袋食谱'}}</view></view><t-icon name="chevron-right" size="32rpx" /></view>
    <view wx:if="{{nextOffset !== null}}" class="social-more"><t-button theme="primary" variant="text" loading="{{loadingMore}}" disabled="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </block>
</view>
