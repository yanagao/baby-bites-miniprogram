<t-navbar z-index="100" title="关注与粉丝" placeholder left-arrow delta="{{0}}" bind:go-back="back" />
<view class="social-tabs"><t-tabs value="{{tab}}" split="{{false}}" bind:change="changeTab"><t-tab-panel value="recipes" label="关注动态" disabled="{{!!followBusyId}}" /><t-tab-panel value="people" label="关注的人" disabled="{{!!followBusyId}}" /><t-tab-panel value="followers" label="粉丝" disabled="{{!!followBusyId}}" /></t-tabs></view>
<view class="page-shell social-page">
  <view wx:if="{{loading}}" class="social-state muted">{{tab === 'recipes' ? '正在看看小厨房的新菜…' : tab === 'followers' ? '正在加载关注你的人…' : '正在加载关注的人…'}}</view>
  <t-empty wx:elif="{{error}}" icon="info-circle" description="{{error}}"><t-button slot="action" theme="primary" bind:tap="reload">重新加载</t-button></t-empty>
  <block wx:elif="{{tab === 'recipes'}}">
    <view wx:if="{{hasAllergies}}" class="muted">已按宝宝的过敏记录跳过相关食材菜谱{{skippedAllergyCount ? '（已跳过 ' + skippedAllergyCount + ' 道）' : ''}}</view>
    <view wx:if="{{!recipes.length}}" class="panel social-state"><view class="social-empty-title">{{nextCursor ? '这页暂无可推荐菜谱' : skippedAllergyCount ? '已跳过含过敏食材的菜谱' : '还没有关注的菜谱'}}</view><view class="muted">{{nextCursor ? '可以继续加载下一页，看看其他菜谱。' : skippedAllergyCount ? '当前已加载的菜谱均含已记录过敏食材，可稍后查看其他新菜。' : '打开好友分享的主页并关注，对方上传的食谱会出现在这里。'}}</view><view class="social-empty-action"><t-button theme="primary" variant="outline" size="small" bind:tap="showPeople">查看关注的人</t-button></view></view>
    <view wx:for="{{recipes}}" wx:key="id" class="feed-card panel">
      <view class="feed-author" data-id="{{item.profileId}}" bindtap="openProfile" hover-class="social-pressed" aria-role="button"><image class="feed-avatar" src="{{item.authorAvatar}}" mode="aspectFit" aria-hidden="true" /><text>{{item.authorName}}</text><t-icon name="chevron-right" size="26rpx" /></view>
      <view class="social-recipe feed-recipe" data-id="{{item.id}}" bindtap="openRecipe" hover-class="social-pressed" aria-role="button" aria-label="{{'查看' + item.name}}"><image wx:if="{{item.photoURL || item.displayPhoto}}" src="{{item.photoURL || item.displayPhoto}}" class="social-photo" mode="aspectFill" data-id="{{item.id}}" data-url="{{item.photoURL || item.displayPhoto}}" binderror="photoError" /><view wx:else class="social-photo social-art"><food-art name="{{item.ingredients[0].name}}" size="100" /></view><view class="social-recipe-copy"><view class="social-recipe-title">{{item.name}}</view><view class="muted">{{item.category}}</view><view class="social-meta">{{item.minutes}} 分钟 · {{item.texture}}</view></view><t-icon name="chevron-right" size="32rpx" /></view>
    </view>
    <view wx:if="{{nextCursor}}" class="social-more"><t-button theme="primary" variant="text" loading="{{loadingMore}}" disabled="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </block>
  <block wx:else>
    <view wx:if="{{!profiles.length}}" class="panel social-state"><view class="social-empty-title">{{nextOffset !== null ? '这页暂无可显示的主页' : tab === 'followers' ? '暂无可显示的粉丝' : '还没有关注的人'}}</view><view class="muted">{{nextOffset !== null ? '部分主页暂不可用，可以继续加载下一页。' : tab === 'followers' ? '把自己的主页分享给朋友。有人关注你后，可以在这里回关。' : '打开好友分享的主页，点「关注」，就能在这里找到 TA。'}}</view><view class="social-empty-action"><t-button theme="primary" variant="outline" size="small" bind:tap="openMine">打开我的主页</t-button></view></view>
    <view wx:for="{{profiles}}" wx:key="id" class="social-recipe person-card panel">
      <view class="person-open" data-id="{{item.id}}" bindtap="openProfile" hover-class="social-pressed" aria-role="button" aria-label="{{'打开' + item.name + '的主页'}}"><view class="person-avatar"><image class="person-avatar-image" src="{{item.avatar}}" mode="aspectFit" aria-hidden="true" /></view><view class="social-recipe-copy"><view class="social-recipe-title">{{item.name}}</view><view class="person-bio muted">{{item.bio || '看看 TA 的口袋食谱'}}</view><view wx:if="{{item.followedBy}}" class="person-relationship">{{item.following ? '你们已互相关注' : 'TA 已关注你'}}</view></view></view>
      <t-button data-id="{{item.id}}" theme="{{item.following ? 'default' : 'primary'}}" variant="{{item.following ? 'outline' : 'base'}}" size="small" shape="round" loading="{{followBusyId === item.id}}" disabled="{{!!followBusyId || loadingMore}}" aria-label="{{item.following ? '取消关注' : item.followedBy ? '回关这位朋友' : '关注这位朋友'}}" bind:tap="toggleFollow">{{item.following ? (item.followedBy ? '互相关注' : '已关注') : (item.followedBy ? '回关' : '关注')}}</t-button>
    </view>
    <view wx:if="{{nextOffset !== null}}" class="social-more"><t-button theme="primary" variant="text" loading="{{loadingMore}}" disabled="{{loadingMore}}" bind:tap="loadMore">加载更多</t-button></view>
  </block>
</view>
