.meal-editor {padding:4rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));color:#345158;}
.meal-date {display:flex;align-items:center;justify-content:center;gap:2rpx;margin-bottom:20rpx;--td-button-small-height:64rpx;--td-button-default-color:#a9babe;}
.meal-date-value {display:flex;align-items:center;gap:8rpx;margin:0;padding:8rpx;background:transparent;color:#345158;font-size:var(--font-body);line-height:var(--line-height-body);}
.meal-date-value::after,.meal-rating::after,.meal-portion::after {border:0;}
.meal-recipe {display:flex;align-items:center;gap:18rpx;padding:16rpx;border-radius:20rpx;background:#eff8f8;border:1rpx solid #e2edf0;}
.meal-recipe>image,.meal-recipe-art {width:110rpx;height:110rpx;flex:none;border-radius:14rpx;background:#eff8f8;}
.meal-recipe-art {display:flex;align-items:center;justify-content:center;}
.meal-recipe-copy {flex:1;min-width:0;}
.meal-recipe-name {font-weight:600;font-size:var(--font-card-title);line-height:1.5;overflow-wrap:anywhere;}
.meal-recipe-meta {display:flex;gap:8rpx;flex-wrap:wrap;margin-top:10rpx;}
.meal-recipe-meta text {padding:3rpx 8rpx;border-radius:8rpx;background:#fff1b8;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);}
.meal-section {margin:28rpx 0 0;}
.meal-section-title {font-size:var(--font-section-title);font-weight:600;line-height:1.5;color:#345158;}
.meal-ratings {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20rpx;margin-top:18rpx;}
.meal-rating {display:flex;min-width:0;flex-direction:column;align-items:center;gap:12rpx;padding:14rpx 6rpx;margin:0;background:transparent;border-radius:20rpx;font-size:var(--font-secondary);line-height:var(--line-height-body);color:#82969a;}
.meal-rating-face {display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:50%;background:#eff8f8;color:#73c6e8;}
.meal-rating-selected {color:#345158;font-weight:500;}
.meal-rating-selected .meal-rating-face {background:#fff1b8;color:#b38b4f;box-shadow:0 0 0 12rpx #fff1b8;border-radius:50%;}
.meal-portions {display:flex;flex-wrap:wrap;gap:8rpx;margin-top:18rpx;}
.meal-portion {flex:1 1 112rpx;min-width:0;margin:0;padding:13rpx 6rpx;font-size:var(--font-caption);line-height:var(--line-height-body);background:#eff8f8;color:#82969a;border-radius:18rpx;overflow-wrap:anywhere;}
.meal-portion-selected {background:#55bba4;color:#153f37;}
.meal-optional {font-weight:400;font-size:var(--font-caption);color:#9aadb1;margin-left:12rpx;line-height:var(--line-height-body);}
.meal-note {overflow:hidden;margin-top:14rpx;border-radius:18rpx;--td-textarea-background-color:#eff8f8;--td-textarea-padding:20rpx;--td-font-body-large: 400 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-font-body-medium: 400 var(--font-secondary)/var(--line-height-body) var(--td-font-family);--td-font-body-small: 400 var(--font-caption)/var(--line-height-body) var(--td-font-family);--td-textarea-placeholder-color:#9aadb1;--td-textarea-indicator-text-color:#9aadb1;min-height:132rpx;background:#eff8f8;}
.meal-error {color:#b36f55;font-size:var(--font-secondary);line-height:var(--line-height-body);margin:12rpx 0;}
.meal-management {margin-top:24rpx;border-radius:16rpx;overflow:hidden;--td-collapse-panel-bg-color:transparent;--td-collapse-header-text-color:#82969a;--td-collapse-header-height:80rpx;--td-collapse-title-font: 400 var(--font-body)/var(--line-height-body) var(--td-font-family);}
.meal-save {position:fixed;left:0;right:0;bottom:0;z-index:20;padding:16rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:#ffffff;--td-button-medium-height:88rpx;--td-button-medium-font: 500 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-button-primary-bg-color:#55bba4;--td-button-primary-border-color:#55bba4;}
