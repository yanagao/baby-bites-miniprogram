.family-page {padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));}
.family-heading {font-size:var(--font-page-title);font-weight:600;line-height:1.4;overflow-wrap:anywhere;}
.family-intro {margin:12rpx 0 28rpx;}
.family-card {margin-bottom:24rpx;padding:24rpx;border:1rpx solid #e5eef0;border-radius:24rpx;}
.family-title {font-size:var(--font-card-title);font-weight:600;line-height:1.5;}
.family-card-heading {display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx;}
.family-note {display:block;font-size:var(--font-secondary);line-height:var(--line-height-body);color:#82969a;margin:14rpx 0 20rpx;overflow-wrap:anywhere;}
.family-roles {display:flex;flex-wrap:wrap;gap:12rpx;margin:16rpx 0;}
.family-role {margin:0;padding:10rpx 24rpx;border-radius:999rpx;background:#eff8f8;color:#527a83;font-size:var(--font-secondary);line-height:1.6;}
.family-role::after {border:0;}.family-role-selected {background:#55bba4;color:#153f37;}
.family-preview {padding:20rpx;margin-top:20rpx;background:#eff8f8;border-radius:18rpx;}
.family-actions {display:flex;gap:14rpx;justify-content:flex-end;flex-wrap:wrap;margin-top:16rpx;}
.family-code {display:block;font-size:var(--font-body);letter-spacing:1rpx;overflow-wrap:anywhere;}
.family-member {padding:16rpx 0;border-bottom:1rpx solid #edf3f4;}.family-member:last-child {border-bottom:0;}
.family-member-name {display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;font-size:var(--font-body);}
.family-badge {font-size:var(--font-caption);padding:2rpx 10rpx;border-radius:10rpx;background:#eff8f8;color:#527a83;}
.family-member-actions {display:flex;justify-content:flex-end;gap:12rpx;margin-top:8rpx;}
.family-birthday {display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:22rpx 0;}
.family-status,.family-error {padding:16rpx 0;font-size:var(--font-secondary);line-height:var(--line-height-body);text-align:center;overflow-wrap:anywhere;}.family-status {color:#527a83;}.family-error {color:#b36f55;}
.family-state {padding:40rpx 12rpx;display:flex;flex-direction:column;text-align:center;gap:20rpx;}
.family-leave {display:block;margin:16rpx 0;}
