<t-navbar title="宝宝的家庭" placeholder left-arrow delta="{{0}}" bind:go-back="back" />
<view class="family-page">
  <view wx:if="{{loading}}" class="empty-note">正在打开家庭…</view>
  <view wx:elif="{{error}}" class="family-state"><text>{{error}}</text><t-button theme="primary" variant="text" bind:tap="reload">重新加载</t-button></view>
  <block wx:else>
    <block wx:if="{{!family}}">
      <view class="family-heading">一家人，一起记</view>
      <view class="muted family-intro">爸爸妈妈和祖辈共用一份宝宝辅食记录。每个家庭先照顾一个宝宝，无需完善个人主页资料。</view>
      <view class="family-card">
        <view class="family-title">你与宝宝的关系</view>
        <view class="family-roles"><button wx:for="{{roleOptions}}" wx:key="*this" class="family-role {{roleLabel === item ? 'family-role-selected' : ''}}" data-label="{{item}}" bindtap="chooseRole" disabled="{{busy}}">{{item}}</button></view>
        <t-input value="{{roleLabel}}" maxlength="20" borderless disabled="{{busy}}" placeholder="也可以填写其他称谓" bind:change="changeRole" />
      </view>
      <view class="family-card">
        <view class="family-title">创建宝宝的家庭</view>
        <t-input label="家庭名称" layout="vertical" value="{{name}}" maxlength="30" borderless disabled="{{busy}}" bind:change="changeName" />
        <view class="family-note">把当前宝宝的数据作为家庭的起点，再邀请家人加入。</view>
        <t-button theme="primary" block shape="round" disabled="{{busy}}" bind:tap="create">创建家庭</t-button>
      </view>
      <view class="family-card">
        <view class="family-title">已有家人创建了家庭？</view>
        <t-input label="邀请码" layout="vertical" value="{{token}}" maxlength="128" borderless disabled="{{busy}}" placeholder="填写家人发来的邀请码" bind:change="changeToken" />
        <t-button theme="primary" variant="outline" block disabled="{{busy}}" bind:tap="previewInvite">查看邀请</t-button>
        <view wx:if="{{preview}}" class="family-preview"><view class="family-title">{{preview.name}}</view><view>{{preview.nickname}} · {{preview.memberCount}} 位家人</view><text class="family-note">{{inviteExpiry}}</text><view class="family-note">加入后切换到这个宝宝的记录，原来的个人数据保留，不会自动合并。</view><t-button theme="primary" block disabled="{{busy}}" bind:tap="join">加入这个家庭</t-button></view>
      </view>
    </block>
    <block wx:else>
      <view class="family-heading">{{family.name}}</view>
      <view class="muted family-intro">{{family.memberCount}} 位家人，共同照顾 {{nickname}}</view>
      <view class="family-card">
        <view class="family-card-heading"><view class="family-title">宝宝资料</view><t-button wx:if="{{!babyEditing}}" size="small" theme="primary" variant="text" disabled="{{busy}}" bind:tap="editBaby">编辑</t-button></view>
        <block wx:if="{{babyEditing}}">
          <t-input label="宝宝称呼" value="{{nickname}}" maxlength="20" borderless disabled="{{busy}}" bind:change="changeNickname" />
          <picker mode="date" value="{{babyBirthDate || birthDateToday}}" start="1900-01-01" end="{{birthDateToday}}" disabled="{{busy}}" bindchange="changeBirthDate"><view class="family-birthday"><text>宝宝生日 · 选填</text><text>{{babyBirthDate || '选择生日'}}</text></view></picker>
          <t-button wx:if="{{babyBirthDate}}" size="small" theme="primary" variant="text" disabled="{{busy}}" bind:tap="clearBirthDate">清除生日</t-button>
          <view class="family-actions"><t-button theme="default" variant="text" disabled="{{busy}}" bind:tap="cancelBaby">取消</t-button><t-button theme="primary" disabled="{{busy}}" bind:tap="saveBaby">保存宝宝资料</t-button></view>
        </block>
        <view wx:else>{{nickname}}<text wx:if="{{babyAgeLabel}}"> · {{babyAgeLabel}}</text></view>
        <view class="family-note">宝宝称呼、生日、食谱、收藏、过敏食物和用餐记录在家庭内共享，不会因此公开给其他用户。</view>
      </view>
      <view class="family-card">
        <view class="family-card-heading"><view class="family-title">家人</view><t-button size="small" theme="primary" variant="text" disabled="{{busy}}" bind:tap="editRole">修改我的称谓</t-button></view>
        <view wx:if="{{roleEditing}}" class="family-role-editor"><view class="family-roles"><button wx:for="{{roleOptions}}" wx:key="*this" class="family-role {{roleLabel === item ? 'family-role-selected' : ''}}" data-label="{{item}}" bindtap="chooseRole" disabled="{{busy}}">{{item}}</button></view><t-input value="{{roleLabel}}" maxlength="20" borderless disabled="{{busy}}" bind:change="changeRole" /><view class="family-actions"><t-button theme="default" variant="text" disabled="{{busy}}" bind:tap="cancelRole">取消</t-button><t-button theme="primary" disabled="{{busy}}" bind:tap="saveRole">保存称谓</t-button></view></view>
        <view wx:for="{{family.members}}" wx:key="id" class="family-member"><view class="family-member-name">{{item.label}}<text wx:if="{{item.isSelf}}" class="family-badge">我</text><text wx:if="{{item.isManager}}" class="family-badge">管理员</text></view><view wx:if="{{family.isManager && !item.isSelf}}" class="family-member-actions"><t-button size="small" theme="primary" variant="text" data-id="{{item.id}}" disabled="{{busy}}" bind:tap="transferManager">转让管理</t-button><t-button size="small" theme="default" variant="text" data-id="{{item.id}}" disabled="{{busy}}" bind:tap="removeMember">移出</t-button></view></view>
      </view>
      <view wx:if="{{family.isManager}}" class="family-card">
        <view class="family-title">邀请家人一起记录</view>
        <view class="family-note">邀请仅供信任的家人使用，24 小时内有效且只能使用一次。新建邀请会使上一份邀请失效。</view>
        <t-button theme="primary" variant="outline" block disabled="{{busy}}" bind:tap="generateInvite">{{invite ? '重新生成邀请' : '生成家庭邀请'}}</t-button>
        <view wx:if="{{invite}}" class="family-preview"><text class="family-code" user-select>{{invite.token}}</text><view class="family-note">{{inviteExpiry}}</view><view class="family-actions"><t-button theme="default" disabled="{{busy}}" bind:tap="copyInvite">复制邀请码</t-button><t-button theme="primary" open-type="share" custom-dataset="{{ {invite: '1'} }}" disabled="{{busy}}">发送给家人</t-button></view></view>
      </view>
      <view wx:else class="family-note">需要邀请其他家人时，请联系家庭管理员生成邀请。</view>
      <t-button class="family-leave" theme="default" variant="text" block disabled="{{busy}}" bind:tap="leave">{{family.memberCount === 1 ? '解散家庭' : '退出家庭'}}</t-button>
    </block>
    <view wx:if="{{busy}}" class="family-status">{{busyText}}</view>
    <view wx:if="{{actionError}}" class="family-error" role="alert">{{actionError}}</view>
  </block>
</view>
<t-dialog visible="{{confirmVisible}}" title="{{confirmTitle}}" content="{{confirmText}}" confirm-btn="{{confirmLabel}}" cancel-btn="取消" bind:confirm="confirmOperation" bind:cancel="cancelConfirm" />
