<t-navbar title="{{inviteMode ? '加入家庭' : '宝宝的家庭'}}" placeholder left-arrow delta="{{0}}" bind:go-back="back" />
<view class="family-page">
  <view wx:if="{{loading}}" class="empty-note">正在打开家庭…</view>
  <view wx:elif="{{error}}" class="family-state"><text>{{error}}</text><t-button theme="primary" variant="text" bind:tap="reload">重新加载</t-button></view>
  <block wx:else>
    <view wx:if="{{inviteMode}}" class="family-invitation">
      <block wx:if="{{family}}">
        <view class="family-heading">你已加入一个家庭</view>
        <view class="muted family-intro">当前正在和「{{family.name}}」的家人一起记录。</view>
        <view class="family-card"><view class="family-note">每次只能加入一个家庭。如果这就是受邀的家庭，可以直接查看家庭资料。</view></view>
        <t-button theme="primary" block shape="round" bind:tap="openCurrentFamily">查看我的家庭</t-button>
      </block>
      <block wx:elif="{{preview}}">
        <view class="family-invite-step">{{inviteStep === 'confirm' ? '第 1 步 · 确认家庭' : '第 2 步 · 填写身份'}}</view>
        <view class="family-heading">{{inviteStep === 'confirm' ? '家人邀请你一起记录' : '你与宝宝的关系'}}</view>
        <view class="muted family-intro">{{inviteStep === 'confirm' ? '一起照顾宝宝，分享每一餐。' : '选择你的身份，也可以填写其他称谓。'}}</view>
        <view class="family-card family-invite-summary">
          <view class="family-title">{{preview.name}}</view>
          <view class="family-baby-summary">{{preview.nickname}} · {{preview.memberCount}} 位家人</view>
          <view wx:if="{{inviteStep === 'confirm'}}" class="family-note family-invite-expiry">{{inviteExpiry}}</view>
        </view>
        <block wx:if="{{inviteStep === 'confirm'}}">
          <view class="family-note family-invite-explanation">加入后和家人共用宝宝的辅食记录。原来的个人数据会保留，不会自动合并。</view>
          <t-button class="family-invite-primary" theme="primary" block shape="round" disabled="{{busy}}" bind:tap="confirmInvitation">确认加入这个家庭</t-button>
          <t-button class="family-invite-secondary" theme="default" variant="text" block disabled="{{busy}}" bind:tap="back">暂不加入</t-button>
        </block>
        <block wx:else>
          <view class="family-card family-invite-role">
            <view class="family-title">我的身份</view>
            <view class="family-roles"><button wx:for="{{roleOptions}}" wx:key="*this" class="family-role {{roleLabel === item ? 'family-role-selected' : ''}}" data-label="{{item}}" bindtap="chooseRole" disabled="{{busy}}">{{item}}</button></view>
            <view class="family-field"><t-input value="{{roleLabel}}" maxlength="20" borderless disabled="{{busy}}" placeholder="也可以填写其他称谓" bind:change="changeRole" /></view>
          </view>
          <t-button class="family-invite-primary" theme="primary" block shape="round" loading="{{busy}}" disabled="{{busy}}" bind:tap="join">{{busy ? '正在加入…' : '完成加入'}}</t-button>
          <t-button class="family-invite-secondary" theme="default" variant="text" block disabled="{{busy}}" bind:tap="backToInvitation">上一步</t-button>
        </block>
      </block>
      <view wx:elif="{{busy}}" class="family-state">正在查看家庭邀请…</view>
      <view wx:else class="family-state">
        <view class="family-title">{{inviteUnavailable ? '邀请已失效' : '暂时无法查看邀请'}}</view>
        <view class="family-note">{{inviteError || '请重新打开家人发来的邀请。'}}</view>
        <t-button wx:if="{{!inviteUnavailable && token}}" theme="primary" block shape="round" bind:tap="previewInvite">重新查看</t-button>
        <t-button theme="default" variant="text" block bind:tap="back">返回</t-button>
      </view>
    </view>
    <block wx:elif="{{!family}}">
      <view class="family-heading">一家人，一起记</view>
      <view class="muted family-intro">爸爸妈妈和祖辈共用一份宝宝辅食记录。每个家庭先照顾一个宝宝，无需完善个人主页资料。</view>
      <view class="family-card">
        <view class="family-title">你与宝宝的关系</view>
        <view class="family-roles"><button wx:for="{{roleOptions}}" wx:key="*this" class="family-role {{roleLabel === item ? 'family-role-selected' : ''}}" data-label="{{item}}" bindtap="chooseRole" disabled="{{busy}}">{{item}}</button></view>
        <view class="family-field"><t-input value="{{roleLabel}}" maxlength="20" borderless disabled="{{busy}}" placeholder="也可以填写其他称谓" bind:change="changeRole" /></view>
      </view>
      <view class="family-card">
        <view class="family-title">创建宝宝的家庭</view>
        <view class="family-field"><t-input label="家庭名称" layout="vertical" value="{{name}}" maxlength="30" borderless disabled="{{busy}}" bind:change="changeName" /></view>
        <view class="family-note">把当前宝宝的数据作为家庭的起点，再邀请家人加入。</view>
        <t-button theme="primary" block shape="round" disabled="{{busy}}" bind:tap="create">创建家庭</t-button>
      </view>
      <view class="family-card">
        <view class="family-title">已有家人创建了家庭？</view>
        <view class="family-field"><t-input label="邀请码" layout="vertical" value="{{token}}" maxlength="128" borderless disabled="{{busy}}" placeholder="填写家人发来的邀请码" bind:change="changeToken" /></view>
        <t-button theme="primary" variant="outline" block shape="round" disabled="{{busy}}" bind:tap="previewInvite">查看邀请</t-button>
      </view>
    </block>
    <block wx:else>
      <view class="family-heading">{{family.name}}</view>
      <view class="muted family-intro">{{family.memberCount}} 位家人，共同照顾 {{nickname}}</view>
      <view class="family-card">
        <view class="family-card-heading"><view class="family-title">宝宝资料</view><t-button wx:if="{{!babyEditing}}" class="family-heading-action" size="small" theme="primary" variant="text" disabled="{{busy}}" bind:tap="editBaby">编辑</t-button></view>
        <block wx:if="{{babyEditing}}">
          <view class="family-field"><t-input label="宝宝称呼" layout="vertical" value="{{nickname}}" maxlength="20" borderless disabled="{{busy}}" bind:change="changeNickname" /></view>
          <view class="family-field">
            <picker mode="date" value="{{babyBirthDate || birthDateToday}}" start="1900-01-01" end="{{birthDateToday}}" disabled="{{busy}}" bindchange="changeBirthDate"><view class="family-birthday"><text class="family-field-label">宝宝生日 · 选填</text><view class="family-birthday-value {{babyBirthDate ? '' : 'family-field-placeholder'}}"><text>{{babyBirthDate || '选择生日'}}</text><t-icon name="chevron-right" size="32rpx" /></view></view></picker>
            <view wx:if="{{babyBirthDate}}" class="family-birthday-clear"><t-button size="small" theme="primary" variant="text" disabled="{{busy}}" bind:tap="clearBirthDate">清除生日</t-button></view>
          </view>
          <view class="family-actions"><t-button theme="default" variant="text" disabled="{{busy}}" bind:tap="cancelBaby">取消</t-button><t-button theme="primary" disabled="{{busy}}" bind:tap="saveBaby">保存宝宝资料</t-button></view>
        </block>
        <view wx:else class="family-baby-summary">{{nickname}}<text wx:if="{{babyAgeLabel}}"> · {{babyAgeLabel}}</text></view>
        <view class="family-note">宝宝称呼、生日、收藏、过敏食物和用餐记录只在家庭内共享。自行创建的菜谱同步后会展示给其他家长。</view>
      </view>
      <view class="family-card">
        <view class="family-card-heading"><view class="family-title">家人</view><t-button class="family-heading-action" size="small" theme="primary" variant="text" disabled="{{busy}}" bind:tap="editRole">修改我的称谓</t-button></view>
        <view wx:if="{{roleEditing}}" class="family-role-editor"><view class="family-roles"><button wx:for="{{roleOptions}}" wx:key="*this" class="family-role {{roleLabel === item ? 'family-role-selected' : ''}}" data-label="{{item}}" bindtap="chooseRole" disabled="{{busy}}">{{item}}</button></view><view class="family-field"><t-input label="我的称谓" layout="vertical" value="{{roleLabel}}" maxlength="20" borderless disabled="{{busy}}" bind:change="changeRole" /></view><view class="family-actions"><t-button theme="default" variant="text" disabled="{{busy}}" bind:tap="cancelRole">取消</t-button><t-button theme="primary" disabled="{{busy}}" bind:tap="saveRole">保存称谓</t-button></view></view>
        <view wx:for="{{family.members}}" wx:key="id" class="family-member"><view class="family-member-name">{{item.label}}<text wx:if="{{item.isSelf}}" class="family-badge">我</text><text wx:if="{{item.isManager}}" class="family-badge">管理员</text></view><view wx:if="{{family.isManager && !item.isSelf}}" class="family-member-actions"><t-button size="small" theme="primary" variant="text" data-id="{{item.id}}" disabled="{{busy}}" bind:tap="transferManager">转让管理</t-button><t-button size="small" theme="default" variant="text" data-id="{{item.id}}" disabled="{{busy}}" bind:tap="removeMember">移出</t-button></view></view>
      </view>
      <view wx:if="{{family.isManager}}" class="family-card">
        <view class="family-title">邀请家人一起记录</view>
        <view class="family-note">邀请仅供信任的家人使用，24 小时内有效且只能使用一次。新建邀请会使上一份邀请失效。</view>
        <t-button theme="primary" block shape="round" disabled="{{busy}}" bind:tap="generateInvite">{{invite ? '重新生成邀请' : '生成家庭邀请'}}</t-button>
        <view wx:if="{{invite}}" class="family-preview"><text class="family-code" user-select>{{invite.token}}</text><view class="family-note">{{inviteExpiry}}</view><view class="family-actions"><t-button theme="default" disabled="{{busy}}" bind:tap="copyInvite">复制邀请码</t-button><t-button theme="primary" open-type="share" custom-dataset="{{ {invite: '1'} }}" disabled="{{busy}}">发送给家人</t-button></view></view>
      </view>
      <view wx:else class="family-note">需要邀请其他家人时，请联系家庭管理员生成邀请。</view>
      <t-button class="family-leave" theme="default" variant="text" block disabled="{{busy}}" bind:tap="leave">{{family.memberCount === 1 ? '解散家庭' : '退出家庭'}}</t-button>
    </block>
    <view wx:if="{{busy && !inviteMode}}" class="family-status">{{busyText}}</view>
    <view wx:if="{{actionError}}" class="family-error" role="alert">{{actionError}}</view>
  </block>
</view>
<t-dialog visible="{{confirmVisible}}" title="{{confirmTitle}}" content="{{confirmText}}" confirm-btn="{{confirmLabel}}" cancel-btn="取消" bind:confirm="confirmOperation" bind:cancel="cancelConfirm" />
