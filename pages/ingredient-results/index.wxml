<t-navbar z-index="100" title="食材匹配结果" placeholder left-arrow delta="{{0}}" bind:go-back="back" />
<t-notice-bar wx:if="{{warning}}" visible theme="warning" content="{{warning}}" />
<view class="page-shell ingredient-results-page">
  <view class="selected-summary"><view class="selected-summary-copy"><text class="selected-label">已选 {{pantry.length}} 种食材</text><text class="selected-text">{{selectedText || '还没有选食材'}}</text></view><button class="adjust-ingredients" bindtap="selectIngredients">继续选食材 <t-icon name="chevron-right" size="24rpx" /></button></view>
  <view class="results-heading"><view class="section-title">找到 {{matches.length}} 道菜谱</view><view wx:if="{{pantry.length}}" class="match-filter-row"><text>食材齐全</text><t-switch value="{{completeOnly}}" bind:change="changeComplete" aria-label="只看食材齐全" size="small" /></view></view>
  <view wx:if="{{completeMatches.length}}" class="match-section"><view class="match-section-heading match-heading-complete"><t-icon name="check-circle-filled" size="27rpx" /><text>食材已齐 · {{completeMatches.length}} 道</text></view><view class="match-grid"><button wx:for="{{completeMatches}}" wx:key="id" class="match-card" data-id="{{item.id}}" bindtap="openRecipe" aria-label="查看{{item.name}}，食材已齐"><view class="match-cover"><image wx:if="{{item.displayPhoto}}" class="match-photo" src="{{item.displayPhoto}}" mode="aspectFill" /><view wx:else class="match-art"><food-art name="{{item.ingredients[0].name}}" size="180" /></view><text class="match-cover-tag">食材已齐</text></view><view class="match-name">{{item.name}}</view><view class="match-meta">{{item.minutes}} 分钟 · {{item.texture}}</view></button></view></view>
  <view wx:if="{{partialMatches.length}}" class="match-section"><view class="match-section-heading match-heading-partial"><t-icon name="add-circle" size="27rpx" /><text>再添一点 · {{partialMatches.length}} 道</text></view><view class="match-grid"><button wx:for="{{partialMatches}}" wx:key="id" class="match-card" data-id="{{item.id}}" bindtap="openRecipe" aria-label="查看{{item.name}}，还缺{{item.missingText}}"><view class="match-cover"><image wx:if="{{item.displayPhoto}}" class="match-photo" src="{{item.displayPhoto}}" mode="aspectFill" /><view wx:else class="match-art"><food-art name="{{item.ingredients[0].name}}" size="180" /></view><text class="match-cover-tag match-cover-partial">还缺 {{item.missingCount}} 样</text></view><view class="match-name">{{item.name}}</view><view class="match-meta">{{item.minutes}} 分钟 · {{item.texture}}</view><view class="match-missing">还缺：{{item.missingText}}</view></button></view></view>
  <view wx:if="{{!matches.length}}" class="results-empty"><image src="/assets/cute/pocket-mascot.png" mode="aspectFit" aria-hidden="true" /><view class="section-title">{{pantry.length ? '换几样食材试试吧' : '先看看冰箱里有什么'}}</view><view class="muted">{{!pantry.length ? '选好食材，小口袋再帮你找菜' : completeOnly ? '还没有食材齐全的菜谱，试试关闭筛选' : '已有食谱中没有匹配结果，可以调整食材再试'}}</view><t-button theme="primary" variant="outline" shape="round" bind:tap="selectIngredients">继续选食材</t-button></view>
</view>
