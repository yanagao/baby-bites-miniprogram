.ingredient-results-page {padding:18rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));color:#345158;}
.selected-summary {display:flex;flex-wrap:wrap;align-items:center;gap:12rpx 20rpx;padding:20rpx;background:#eff8f8;border-radius:22rpx;}
.selected-summary-copy {flex:1;min-width:220rpx;}
.selected-label {display:block;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);}
.selected-text {display:block;margin-top:6rpx;font-size:var(--font-body);line-height:var(--line-height-body);overflow-wrap:anywhere;}
.adjust-ingredients {display:flex;align-items:center;gap:4rpx;white-space:nowrap;margin:0 0 0 auto;padding:8rpx 0;min-height:52rpx;line-height:var(--line-height-body);font-size:var(--font-body);color:#439e86;background:transparent;}
.adjust-ingredients::after,.match-card::after {border:0;}
.results-heading {display:flex;align-items:center;justify-content:space-between;gap:20rpx;flex-wrap:wrap;margin:26rpx 0;}
.results-heading .section-title {font-size:var(--font-section-title);color:#345158;line-height:1.4;}
.match-filter-row {display:flex;align-items:center;gap:10rpx;font-size:var(--font-secondary);color:#82969a;--td-switch-checked-color:#55bba4;line-height:var(--line-height-body);}
.match-section {margin-bottom:28rpx;}
.match-section-heading {display:flex;align-items:center;gap:9rpx;margin-bottom:18rpx;font-size:var(--font-section-title);line-height:1.4;font-weight:600;}
.match-heading-complete {color:#439e86;}.match-heading-partial {color:#a38e59;}
.match-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26rpx 20rpx;}
.match-card {width:100%;min-width:0;margin:0;padding:0;background:transparent;text-align:left;line-height:1.4;}
.match-cover {position:relative;overflow:hidden;border-radius:24rpx;background:#eff8f8;}
.match-photo,.match-art {display:block;width:100%;height:244rpx;}
.match-art {display:flex;align-items:center;justify-content:center;}
.match-cover-tag {position:absolute;top:12rpx;right:12rpx;padding:4rpx 11rpx;border-radius:14rpx;background:#eff8f8;color:#153f37;font-size:var(--font-caption);line-height:var(--line-height-body);max-width:calc(100% - 24rpx);overflow-wrap:anywhere;}
.match-cover-partial {background:#fff1b8;color:#a38e59;}
.match-name {margin-top:12rpx;font-size:var(--font-card-title);line-height:1.4;font-weight:600;color:#345158;overflow-wrap:anywhere;}
.match-meta {margin-top:7rpx;font-size:var(--font-secondary);line-height:var(--line-height-body);color:#82969a;}
.match-missing {margin-top:6rpx;font-size:var(--font-secondary);line-height:var(--line-height-body);color:#a38e59;overflow-wrap:anywhere;}
.results-empty {padding:28rpx 16rpx;text-align:center;}.results-empty image {width:180rpx;height:180rpx;}.results-empty .section-title {font-size:var(--font-section-title);line-height:1.4;}.results-empty .muted {margin:16rpx 0 26rpx;font-size:var(--font-secondary);line-height:var(--line-height-body);}
