<view class="page">
  <view class="card random-settings">
    <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category">
      <t-cell title="菜谱分类" note="{{categories[categoryIndex]}}" arrow />
    </picker>
    <t-cell title="避开最近不太喜欢的" bordered="{{false}}">
      <t-switch slot="right-icon" value="{{skipDisliked}}" bind:change="skip" />
    </t-cell>
  </view>
  <view class="card result" wx:if="{{result}}">
    <view class="result-symbol"><ui-icon name="dice" tone="blue" size="44" /></view>
    <view class="muted">这次随机选到</view>
    <view class="result-name">{{result.name}}</view>
    <view class="muted">{{result.ingredientText}}</view>
    <view class="helper">{{result.minutes}} 分钟 · {{result.texture}}</view>
    <view class="result-rating rating-state">
      <t-tag wx:if="{{result.rating > 0}}" theme="{{result.rating === 3 ? 'primary' : result.rating === 2 ? 'success' : 'warning'}}" variant="light" shape="round" size="medium" aria-label="已记录喜好：{{result.ratingName}}"><ui-icon slot="icon" name="{{result.ratingIcon}}" tone="{{result.rating === 3 ? 'blue' : result.rating === 2 ? 'green' : 'brown'}}" size="18" />{{result.ratingName}}</t-tag>
      <text wx:else class="rating-pending">还没记录喜好</text>
    </view>
    <t-button theme="primary" size="large" block bind:tap="detail">就吃这个，看看做法</t-button>
    <view class="redraw"><t-button theme="primary" variant="outline" size="large" block icon="refresh" bind:tap="draw">再随机一次</t-button></view>
  </view>
  <view wx:else class="card empty-card">
    <t-empty icon="file-unknown" description="暂无符合条件的菜谱。试试其他分类，或关闭「避开最近不太喜欢的」。">
      <t-button slot="action" theme="primary" variant="outline" bind:tap="add">添加一道菜谱</t-button>
    </t-empty>
  </view>
</view>
