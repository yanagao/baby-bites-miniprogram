.random-page { padding-top: 32rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.random-result { position: relative; padding: 22rpx; background: #fff0b8; border: 2rpx solid #ffe3a0; border-radius: 44rpx; }
.random-result::before { content: ''; position: absolute; pointer-events: none; inset: 10rpx; border: 2rpx dashed #efd18c; border-radius: 34rpx; }
.random-label { position: absolute; z-index: 2; top: 10rpx; left: 28rpx; padding: 10rpx 22rpx; border: 3rpx solid #fff5e7; border-radius: 16rpx; background: #ffd4d6; color: #ba4057; box-shadow: 0 2rpx 4rpx #dabd8a; font-size: 33rpx; transform: rotate(-8deg); }
.random-photo { display: block; width: 100%; height: 365rpx; border-radius: 28rpx; }
.random-art { display: flex; align-items: center; justify-content: center; height: 330rpx; background: #fcf7dd; border-radius: 28rpx; }
.random-description { position: relative; margin: -16rpx 14rpx 0; padding: 17rpx 14rpx 20rpx; border-radius: 40rpx 40rpx 22rpx 22rpx; background: #fffaf1; text-align: center; }
.random-name { font-size: 49rpx; line-height: 1.3; color: #432820; }
.random-ingredients { margin-top: 8rpx; color: #8d7c70; font-size: 25rpx; line-height: 1.6; }
.random-metadata { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx 18rpx; margin-top: 13rpx; }
.random-metadata > view { display: flex; align-items: center; gap: 8rpx; padding: 5rpx 17rpx; border-radius: 30rpx; background: #ffede6; font-size: 24rpx; line-height: 36rpx; }
.random-preference { margin-top: 13rpx; font-size: 23rpx; color: #a58671; }
.random-actions { position: relative; display: flex; flex-direction: column; gap: 14rpx; margin-top: 14rpx; --td-button-medium-height: 86rpx; --td-button-primary-outline-color: #d94b64; --td-button-primary-outline-border-color: #db5b63; --td-button-primary-outline-bg-color: #fffdf7; }
.random-single { position: relative; margin: 15rpx 6rpx 2rpx; color: #96744b; text-align: center; font-size: 24rpx; line-height: 1.6; }
.random-filters { margin-top: 25rpx; overflow: hidden; --td-collapse-header-bg-color: #fffdfa; }
.random-empty { padding: 28rpx 30rpx 32rpx; text-align: center; }
.random-empty > image { width: 220rpx; height: 220rpx; }
.random-empty-title { margin-top: 10rpx; font-size: 43rpx; line-height: 1.3; }
.random-empty-description { margin: 20rpx 0 28rpx; color: #9b805d; font-size: 26rpx; line-height: 1.7; }
