.random-settings{padding:0;overflow:hidden}.result{text-align:center;padding:42rpx 32rpx}.result-symbol{background:#eef5fd;width:150rpx;height:150rpx;border-radius:42rpx;margin:0 auto 30rpx;display:flex;align-items:center;justify-content:center}.result-name{font-size:46rpx;font-weight:650;line-height:1.35;margin:20rpx 0}.result-rating{margin:20rpx 0 38rpx}.redraw{margin-top:20rpx}.empty-card{padding:72rpx 32rpx;--td-empty-icon-color:#a9bfdc;--td-empty-action-margin-top:32rpx}
.rating-state{--td-tag-medium-padding:10rpx 16rpx;--td-tag-medium-font:550 24rpx/1.4 var(--td-font-family);--td-tag-success-color:#347454;--td-tag-success-light-color:#edf7f1;--td-tag-warning-color:#806448;--td-tag-warning-light-color:#f6f1ea}
.rating-pending{font-size:24rpx;line-height:1.5;color:#64748b}
