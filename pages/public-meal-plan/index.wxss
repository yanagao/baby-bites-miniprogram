.shared-plan-page {padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));color:#345158;}
.shared-plan-heading {display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx;}
.shared-plan-date {margin-bottom:8rpx;color:#82969a;font-size:var(--font-secondary);line-height:var(--line-height-body);}
.shared-plan-heading .page-title {flex:1;min-width:0;font-size:44rpx;overflow-wrap:anywhere;}
.shared-plan-share {display:flex;align-items:center;justify-content:flex-end;gap:8rpx;flex:none;min-width:112rpx;min-height:64rpx;margin:0;padding:0;background:transparent;color:#276e60;font-size:var(--font-secondary);font-weight:500;line-height:1.4;}
.shared-plan-share::after {border:0;}
.shared-plan-author {display:flex;align-items:center;gap:16rpx;width:100%;margin:0 0 24rpx;padding:18rpx 20rpx;border-radius:20rpx;background:#eff8f8;color:#577479;text-align:left;line-height:var(--line-height-body);}
.shared-plan-author::after,.shared-plan-meal::after {border:0;}
.shared-plan-avatar {width:72rpx;height:80rpx;flex:none;}
.shared-plan-author-copy,.shared-plan-meal-copy {flex:1;min-width:0;}
.shared-plan-author-name {color:#345158;font-size:var(--font-body);font-weight:600;overflow-wrap:anywhere;}
.shared-plan-author-caption,.shared-plan-hint {color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);}
.shared-plan-hint {margin:0 4rpx 18rpx;}
.shared-plan-empty {display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx;color:#82969a;font-size:var(--font-secondary);line-height:var(--line-height-body);}
.shared-plan-meal {display:block;width:100%;margin:0 0 20rpx;padding:22rpx;border:2rpx solid #d5e9ec;border-radius:22rpx;background:#eff8f8;color:#345158;text-align:left;line-height:var(--line-height-body);}
.shared-plan-meal-label {display:flex;align-items:center;gap:8rpx;margin-bottom:16rpx;color:#438775;font-size:var(--font-secondary);font-weight:500;}
.shared-plan-meal-content {display:flex;align-items:center;gap:18rpx;}
.shared-plan-photo {width:112rpx;height:112rpx;flex:none;border-radius:16rpx;background:#ffffff;}
.shared-plan-photo-empty {display:flex;align-items:center;justify-content:center;color:#8bbdb5;}
.shared-plan-recipe-name {font-size:var(--font-card-title);font-weight:600;line-height:1.4;overflow-wrap:anywhere;}
.shared-plan-recipe-meta {margin-top:8rpx;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);overflow-wrap:anywhere;}
.shared-plan-meal[disabled] {background:#f7faf9;border-color:#e5eeeb;color:#82969a;}
.shared-plan-meal-empty .shared-plan-recipe-name {font-size:var(--font-body);font-weight:400;}
.shared-plan-meal-empty .shared-plan-meal-label {color:#82969a;}
.shared-plan-pressed {opacity:.72;}
.shared-plan-bottom-space {height:160rpx;}
.shared-plan-bottom {position:fixed;z-index:50;left:0;right:0;bottom:0;padding:18rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e6efee;background:#fff;}
.shared-plan-save-caption {margin-top:8rpx;text-align:center;color:#82969a;font-size:var(--font-caption);line-height:1.5;}
.copy-sheet {max-height:88vh;overflow-y:auto;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));background:#fff;border-radius:28rpx 28rpx 0 0;color:#345158;}
.copy-sheet-heading {display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx;}
.copy-sheet-title {font-size:var(--font-section-title);font-weight:600;line-height:1.4;}
.copy-sheet-close {display:flex;align-items:center;justify-content:center;flex:none;width:60rpx;height:60rpx;margin:0;padding:0;border-radius:50%;background:#eff8f8;color:#82969a;}
.copy-sheet-close::after,.copy-mode::after {border:0;}
.copy-date {display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:22rpx 24rpx;border-radius:18rpx;background:#eff8f8;font-size:var(--font-body);}
.copy-date > view {display:flex;align-items:center;gap:12rpx;color:#276e60;font-weight:500;}
.copy-conflicts {margin-top:22rpx;}
.copy-modes {display:flex;gap:12rpx;margin-top:12rpx;}
.copy-mode {flex:1;min-width:0;margin:0;padding:16rpx 8rpx;border:2rpx solid #d5e9ec;border-radius:18rpx;background:#fff;color:#577479;font-size:var(--font-caption);line-height:1.5;}
.copy-mode-selected {border-color:#55bba4;background:#eff8f8;color:#276e60;font-weight:500;}
.copy-meals {margin:12rpx 0 20rpx;}
.copy-meal {display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #e6efee;}
.copy-meal-label {flex:none;min-width:64rpx;color:#6c8989;font-size:var(--font-secondary);}
.copy-meal-copy {flex:1;min-width:0;}
.copy-meal-name {font-size:var(--font-body);line-height:1.5;overflow-wrap:anywhere;}
.copy-meal-note,.copy-note {color:#82969a;font-size:var(--font-caption);line-height:1.6;overflow-wrap:anywhere;}
.copy-meal-note {margin-top:4rpx;}
.copy-replace-note {color:#a6754f;}
.copy-error {margin-top:16rpx;color:#aa6a45;font-size:var(--font-secondary);line-height:1.6;}
.copy-confirm {display:block;margin-top:22rpx;}
.copy-success {padding:20rpx 0 34rpx;text-align:center;color:#438775;}
.copy-success-title {margin:16rpx 0 8rpx;color:#345158;font-size:var(--font-section-title);font-weight:600;}
