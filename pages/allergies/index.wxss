.allergies-page {padding:26rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));color:#345158;background:#ffffff;}
.allergies-intro {font-size:var(--font-body);line-height:var(--line-height-body);}
.allergies-privacy,.allergies-note,.allergies-boundary {font-size:var(--font-caption);line-height:var(--line-height-body);color:#82969a;}
.allergies-privacy {margin-top:8rpx;}.allergies-note {margin-top:14rpx;}.allergies-boundary {margin-top:28rpx;}
.allergies-section {margin-top:32rpx;}.allergies-heading {display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx;font-size:var(--font-card-title);font-weight:600;}.allergies-heading>text {font-size:var(--font-caption);font-weight:400;color:#82969a;}
.allergies-chips {display:flex;flex-wrap:wrap;gap:14rpx;}.allergies-chip {display:flex;align-items:center;justify-content:center;gap:10rpx;min-height:66rpx;max-width:100%;margin:0;padding:10rpx 24rpx;background:#eff8f8;border:2rpx solid transparent;border-radius:36rpx;color:#577479;font-size:var(--font-secondary);line-height:var(--line-height-body);overflow-wrap:anywhere;}.allergies-chip::after {border:0;}.allergies-chip>text {min-width:0;}.allergies-selected {background:#e1f4ed;border-color:#55bba4;color:#286c59;}.allergies-chip[disabled] {opacity:.6;}
.allergies-empty {padding:24rpx;border-radius:18rpx;background:#eff8f8;font-size:var(--font-secondary);color:#82969a;line-height:var(--line-height-body);}
.allergies-input {display:flex;align-items:center;padding-right:12rpx;background:#eff8f8;border:2rpx solid #d5e9ec;border-radius:18rpx;overflow:hidden;--td-input-bg-color:transparent;--td-input-vertical-padding:20rpx;--td-input-default-text-color:#345158;--td-input-placeholder-text-font:400 var(--font-secondary)/var(--line-height-body) var(--td-font-family);--td-font-body-large:400 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-button-small-font:500 var(--font-secondary)/var(--line-height-body) var(--td-font-family);}.allergies-input>t-input {flex:1;min-width:0;}.allergies-input>t-button {flex:none;}
.allergies-error {margin-top:20rpx;padding:16rpx 20rpx;background:#fff1b8;border-radius:16rpx;font-size:var(--font-secondary);line-height:var(--line-height-body);}
.allergies-actions {position:fixed;bottom:0;left:0;right:0;z-index:20;display:flex;gap:16rpx;padding:16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#ffffff;border-top:1rpx solid #e2edf0;--td-button-medium-height:88rpx;--td-button-medium-font:500 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-button-default-bg-color:#eff8f8;--td-button-default-border-color:#eff8f8;--td-button-default-color:#345158;}.allergies-cancel {flex:1;}.allergies-save {flex:2;}.allergies-unavailable {padding:60rpx 28rpx;}

.allergies-filter {display:flex;align-items:center;justify-content:space-between;gap:24rpx;font-size:var(--font-body);line-height:var(--line-height-body);}
