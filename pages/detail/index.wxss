.detail-page {padding-top:4rpx;}.detail-photo {width:100%;height:390rpx;display:block;border-radius:26rpx;}.detail-art {height:240rpx;display:flex;align-items:center;justify-content:center;background:#f4eedc;border-radius:28rpx;}
.detail-heading {display:flex;align-items:center;gap:12rpx;margin-top:18rpx;}.detail-title {flex:1;font-size:55rpx;line-height:1.24;}.detail-meta {display:flex;align-items:center;gap:16rpx;flex-wrap:wrap;margin:14rpx 0 28rpx;}.detail-meta>view {display:flex;align-items:center;gap:7rpx;background:#f1ebe0;border-radius:30rpx;padding:4rpx 16rpx;font-size:24rpx;line-height:34rpx;}.example-label {font-size:21rpx;color:#a18d79;}
.ingredients-panel {padding:16rpx 24rpx 4rpx;position:relative;}.ingredients-heading {display:flex;align-items:center;justify-content:space-between;margin:0 -8rpx 8rpx;}.ingredients-heading>text:first-child {font-size:37rpx;padding:2rpx 22rpx;background:#ffecaa;border-radius:24rpx;}.ingredients-heading>text:last-child {font-size:23rpx;color:#9c8d80;}.ingredient-row {display:flex;align-items:center;gap:16rpx;min-height:70rpx;border-bottom:1rpx solid #f4eee5;font-size:28rpx;}.ingredient-row:last-child {border-bottom:0;}.ingredient-amount {margin-left:auto;color:#8e7b6d;font-size:25rpx;}
.steps-section {margin-top:30rpx;}.steps-section .section-title {display:flex;align-items:center;gap:14rpx;margin-bottom:14rpx;}.step-row {display:flex;align-items:flex-start;gap:18rpx;margin-bottom:17rpx;}.step-number {display:flex;align-items:center;justify-content:center;flex:none;background:#ffdade;width:48rpx;height:48rpx;border-radius:50%;font-size:28rpx;color:#96505a;}.step-text {font-size:28rpx;line-height:46rpx;}.detail-note {background:#fff3ce;padding:22rpx;border-radius:24rpx;margin:24rpx 0;font-size:26rpx;line-height:1.7;}.detail-note .section-title {font-size:32rpx;margin-bottom:6rpx;}
.last-meal {display:flex;align-items:center;gap:16rpx;background:#f0e5ff;border-radius:24rpx;padding:22rpx;font-size:26rpx;line-height:1.5;margin-top:26rpx;color:#6b4b7a;}.last-meal-copy {flex:1;min-width:0;}.last-meal-date {display:block;font-size:22rpx;color:#9c83a7;margin-top:4rpx;}.detail-manage {text-align:center;padding:22rpx 0 0;}
.detail-bottom-space {height:calc(110rpx + env(safe-area-inset-bottom));}.detail-bottom {position:fixed;left:0;right:0;bottom:0;display:flex;gap:20rpx;align-items:center;padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));background:#fffaf1;border-top:1rpx solid #eee2d1;z-index:10;--td-button-medium-height:90rpx;}.detail-favorite {flex:0 0 35%;}.detail-record {flex:1;}

.detail-title {min-width:0;overflow-wrap:anywhere;}
.publication-panel {margin-top:24rpx;padding:24rpx;}.publication-heading {display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:600;gap:16rpx;}.publication-hint {margin-top:10rpx;font-size:24rpx;line-height:1.6;color:#8a786b;}.publication-actions {display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;margin-top:18rpx;}.publication-error {color:#a83d4b;font-size:24rpx;line-height:1.6;margin-top:12rpx;}
