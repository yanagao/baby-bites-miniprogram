.detail-top{display:flex;gap:16rpx;align-items:flex-start;margin-bottom:20rpx}.detail-top .grow{min-width:0;word-break:break-all}.detail-rating{margin-top:24rpx}.first-title{margin-top:0}.ingredients-card{padding:0;overflow:hidden}.ingredient-heading{font-size:34rpx;font-weight:600;line-height:1.4;padding:32rpx 32rpx 10rpx}.step{display:flex;align-items:flex-start;gap:24rpx;margin:26rpx 0;line-height:1.8}.step-number{width:46rpx;height:46rpx;border-radius:23rpx;text-align:center;background:#eef5fd;color:#0071e3;flex-shrink:0;font-size:25rpx;line-height:46rpx}.detail-note{background:#f7f9fc;border-radius:18rpx;padding:24rpx;font-size:26rpx;color:#526783;margin-top:32rpx}.example-label{margin-top:20rpx}.detail-actions{display:flex;justify-content:center;gap:36rpx;margin-top:18rpx}.empty-card{padding:72rpx 32rpx;--td-empty-icon-color:#a9bfdc;--td-empty-action-margin-top:32rpx}
.rating-state{--td-tag-medium-padding:10rpx 16rpx;--td-tag-medium-font:550 24rpx/1.4 var(--td-font-family);--td-tag-success-color:#347454;--td-tag-success-light-color:#edf7f1;--td-tag-warning-color:#806448;--td-tag-warning-light-color:#f6f1ea}
.rating-pending{font-size:24rpx;line-height:1.5;color:#64748b}
.detail-favorite{flex-shrink:0;--td-button-small-height:88rpx;--td-button-small-padding-horizontal:12rpx;--td-button-small-font:500 26rpx/1.4 var(--td-font-family)}
.detail-favorite-button{margin:0!important;min-height:44px}
.favorite-label{display:flex;align-items:center;justify-content:center;gap:10rpx}
