<t-navbar z-index="100" class="{{recipe ? 'detail-navbar' : ''}}" t-class-left="{{recipe ? 'detail-back' : ''}}" title="{{recipe ? '' : '食谱详情'}}" placeholder="{{!recipe}}" left-arrow delta="{{0}}" bind:go-back="back" />
<view wx:if="{{recipe}}" class="detail-page">
  <view class="detail-cover">
  <image wx:if="{{recipe.photoSrc}}" class="detail-photo" src="{{recipe.photoSrc}}" mode="aspectFill" bindtap="previewPhoto" aria-label="预览成品照片" />
  <image wx:elif="{{recipe.displayPhoto}}" class="detail-photo" src="{{recipe.displayPhoto}}" mode="aspectFill" />
  <view wx:else class="detail-art"><food-art name="{{recipe.ingredients[0].name}}" size="200" /></view>
  </view>
  <view class="detail-body">
  <view class="detail-heading"><view class="detail-title">{{recipe.name}}</view><button class="detail-title-favorite {{recipe.favorite ? 'is-favorite' : ''}}" bindtap="favorite" aria-label="{{recipe.favorite ? '取消收藏这道菜谱' : '收藏这道菜谱'}}"><t-icon name="{{recipe.favorite ? 'heart-filled' : 'heart'}}" size="36rpx" /></button><view wx:if="{{socialEnabled}}" class="detail-share-entry"><t-button wx:if="{{builtIn || (publicReady && shareRecipe && !publicLoading && !shareLoading)}}" theme="primary" variant="text" size="small" icon="share" disabled="{{publicBusy || deleting || deleteVisible}}" open-type="share">分享</t-button><t-button wx:elif="{{!familyRecipe}}" theme="primary" variant="text" size="small" icon="share" loading="{{shareLoading}}" disabled="{{publicBusy || deleting || publicLoading || shareLoading}}" bind:tap="requestShare">分享</t-button></view></view>
  <view class="detail-meta"><view wx:if="{{recipe.category}}" class="detail-category">{{recipe.category}}</view><view><t-icon name="time" size="22rpx" />{{recipe.minutes}} 分钟</view><view><t-icon name="rice" size="22rpx" />{{recipe.texture}}</view><text wx:if="{{builtIn}}" class="example-label">内置菜谱</text></view>
  <view wx:if="{{recipe.allergyWarning}}" class="publication-error" role="alert">{{recipe.allergyWarning}}</view>
  <view class="detail-top-actions">
    <view class="detail-edit-action"><t-button theme="default" shape="round" size="small" block icon="edit" disabled="{{deleting || publicBusy}}" bind:tap="edit">编辑菜谱</t-button></view>
    <view class="detail-delete-action"><t-button theme="danger" shape="round" size="small" block icon="delete" loading="{{deleting}}" disabled="{{deleting || publicBusy}}" bind:tap="remove">删除菜谱</t-button></view>
  </view>
  <view wx:if="{{socialEnabled}}" class="publication-panel">
    <view class="publication-heading">
      <view class="publication-status"><text class="publication-label">{{builtIn ? '内置菜谱' : '菜谱分享'}}</text><view class="publication-state {{!builtIn && publicReady && publicInfo && !publicChanged ? 'publication-state-public' : ''}}"><t-icon name="{{builtIn ? 'book' : publicReady && publicInfo && !publicChanged ? 'check-circle' : 'share'}}" size="28rpx" /><text>{{builtIn ? '保留在你的菜谱中' : publicError ? '暂时无法读取' : publicReady ? publicInfo ? publicChanged ? '分享内容待更新' : '已分享' : '尚未分享' : '正在读取'}}</text></view></view>
    </view>
    <view wx:if="{{!builtIn && (publicLoading || publicBusy)}}" class="publication-loading"><t-loading size="28rpx" /><text>{{publicBusy ? '正在同步菜谱…' : '正在读取同步状态…'}}</text></view>
    <view class="publication-hint">{{builtIn ? '内置菜谱供你选餐和记录用餐，不会出现在推荐和他人可见的主页中。分享仅发送小程序入口。' : publicInfo ? '这道菜已分享给其他家长，保存后的菜谱修改会自动更新。小心得、宝宝信息和用餐记录不会公开。' : familyRecipe ? '这道菜由家人添加。全家可以一起编辑和记录用餐，由添加者选择是否公开分享。' : '菜谱先收在你的食谱里。选择公开分享并确认预览后，其他家长才会看到菜名、照片、食材和做法。小心得、宝宝信息和用餐记录不会公开。'}}</view>
    <view wx:if="{{!builtIn && publicChanged}}" class="publication-hint">修改已保存，联网同步后会自动更新。</view>
    <view wx:if="{{recipe.source}}" class="publication-source">来自 {{recipe.source.authorName}} 的菜谱</view>
    <view wx:if="{{publicError}}" class="publication-error"><text>{{publicError}}</text><t-button size="small" theme="primary" variant="text" disabled="{{publicLoading || publicBusy || deleting}}" bind:tap="refreshPublication">重试</t-button></view>
    <view wx:if="{{shareError}}" class="publication-error"><text>{{shareError}}</text><t-button size="small" theme="primary" variant="text" disabled="{{publicLoading || shareLoading || publicBusy || deleting}}" bind:tap="requestShare">重试分享</t-button></view>
    <view wx:if="{{publicReady && publicInfo}}" class="publication-actions"><t-button size="small" theme="primary" variant="text" disabled="{{publicBusy || deleting}}" bind:tap="openPublicRecipe">查看分享页与大家的反馈</t-button></view>
    <view wx:if="{{recipe.source && !builtIn}}" class="publication-actions"><t-button size="small" theme="primary" variant="text" disabled="{{publicBusy || deleting}}" bind:tap="openCooksnap">我做过这道菜</t-button></view>
  </view>
  <view class="ingredients-panel">
    <view class="ingredients-heading"><text class="brush">需要准备</text><text>{{builtIn ? '示例用量' : '食材与用量'}}</text></view>
    <view wx:for="{{recipe.ingredients}}" wx:key="name" class="ingredient-row"><food-art name="{{item.name}}" size="48" /><text class="ingredient-name">{{item.name}}</text><text class="ingredient-amount">{{item.amount || '适量'}}</text></view>
  </view>
  <view class="steps-section"><view class="section-title">怎么做</view><view wx:for="{{recipe.steps}}" wx:key="index" class="step-row"><text class="step-number">{{index + 1}}</text><text class="step-text">{{item}}</text></view></view>
  <view wx:if="{{recipe.note}}" class="detail-note"><view class="section-title">口袋小心得</view><text>{{recipe.note}}</text></view>
  <view class="last-meal" bindtap="openLastLog" aria-role="button" aria-label="{{lastLog ? '编辑上次用餐记录' : '记录这道菜的用餐喜好'}}"><t-icon name="{{recipe.rating === 3 ? 'heart-filled' : 'history'}}" size="34rpx" /><view class="last-meal-copy"><text>{{recipe.rating > 0 ? '上次：' + recipe.ratingName + (lastLog.portion ? ' · ' + lastLog.portion : '') : '还没记过，宝宝喜欢吗？'}}</text><text wx:if="{{recipe.rating > 0}}" class="last-meal-date">{{recipe.ratingDate}}</text></view><t-icon name="chevron-right" size="28rpx" /></view>
  <view class="detail-bottom-space" />
  </view>
  <view class="detail-bottom"><view class="detail-favorite"><t-button theme="default" shape="round" block icon="{{recipe.favorite ? 'heart-filled' : 'heart'}}" bind:tap="favorite">{{recipe.favorite ? '已收藏' : '收藏'}}</t-button></view><view class="detail-record"><t-button theme="primary" shape="round" block icon="rice" bind:tap="record">记一餐</t-button></view></view>
</view>
<t-empty wx:else icon="file-unknown" description="没有找到这道菜谱，可能已经被删除。"><t-button slot="action" theme="primary" bind:tap="back">返回菜谱列表</t-button></t-empty>
<t-dialog visible="{{deleteVisible}}" title="删除这道菜谱？" content="{{deleteContent}}" confirm-btn="{{deleteConfirmButton}}" cancel-btn="取消" bind:confirm="confirmDelete" bind:cancel="cancelDelete" />
<t-dialog visible="{{shareVisible}}" title="分享这道菜" content="朋友可以查看做法并保存独立副本。">
  <view slot="content" class="recipe-share-preview"><view class="recipe-share-name">{{shareRecipe.name}}</view><view wx:if="{{publicChanged}}" class="recipe-share-hint">将分享当前已同步的菜谱，最新修改将在联网同步后自动更新。</view></view>
  <view slot="actions" class="recipe-share-actions"><t-button theme="default" variant="text" block bind:tap="closeShare">稍后再发</t-button><t-button theme="primary" block icon="share" open-type="share" disabled="{{!shareRecipe || !publicReady || publicBusy || publicLoading || shareLoading || deleting}}">发送给朋友</t-button></view>
</t-dialog>
