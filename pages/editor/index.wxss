.editor-card {
  padding: 0;
  overflow: hidden;
  --td-font-body-large: 28rpx/44rpx var(--td-font-family);
  --td-font-body-medium: 28rpx/44rpx var(--td-font-family);
  --td-input-vertical-padding: 28rpx 32rpx;
  --td-input-suffix-text-color: #64748b;
  --td-font-size-m: 28rpx;
  --td-cell-vertical-padding: 28rpx;
  --td-cell-horizontal-padding: 32rpx;
  --td-cell-title-font: 500 30rpx/44rpx var(--td-font-family);
  --td-cell-note-color: #536b88;
  --td-cell-note-font-size: 28rpx;
  --td-textarea-padding: 28rpx 32rpx;
  --td-button-small-height: 80rpx;
  --td-button-small-font: 500 26rpx/1.4 var(--td-font-family);
  --td-button-small-padding-horizontal: 20rpx;
  --td-button-border-radius: 16rpx;
}
.editor-row { position: relative; }
.editor-row:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #edf1f6;
  pointer-events: none;
}
.editor-field-label { font-size: 30rpx !important; font-weight: 500 !important; line-height: 44rpx !important; }
.editor-choice { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; white-space: nowrap; }
.editor-cell-right { display: none !important; margin: 0 !important; }
.photo-section, .rating-section { padding: 28rpx 32rpx; }
.field-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; font-size: 30rpx; font-weight: 500; line-height: 44rpx; }
.optional-label { color: #8290a3; font-size: 24rpx; font-weight: 400; }
.photo-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.photo-heading .field-title { flex: 1; min-width: 0; }
.photo-action { flex: 0 0 auto; margin-left: auto; }
.photo-button { margin: 0 !important; }
.photo-button-label { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.photo-hint { margin: 8rpx 0 0; }
.photo-section .photo-preview { display: block; margin: 20rpx 0 0; }
.photo-remove-action { display: flex; justify-content: flex-end; margin-top: 8rpx; }
.rating-hint { margin: 8rpx 0 20rpx; }
.rating-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #eef5fd;
  color: #0067cc;
}
.rating-picker-value { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.5; }
.picker-chevron { display: flex; align-items: center; justify-content: center; flex-shrink: 0; transform: rotate(90deg); }
.rating-picker-pressed { background: #dfedff; }
.rating-picker-disabled { opacity: .5; }
.editor-actions { display: flex; gap: 20rpx; }
.action-half { flex: 1; min-width: 0; }
.empty-card { padding: 72rpx 32rpx; --td-empty-icon-color: #a9bfdc; --td-empty-action-margin-top: 32rpx; }
