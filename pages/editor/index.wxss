.editor-page {padding:0 24rpx calc(146rpx + env(safe-area-inset-bottom));color:#345158;background:#ffffff;--td-cell-group-title-bg-color:#ffffff;--td-cell-group-title-color:#345158;--td-cell-group-title-font-size:var(--font-section-title);--td-cell-group-title-line-height:var(--line-height-body);--td-cell-group-title-padding-left:0;--td-cell-bg-color:#eff8f8;--td-cell-vertical-padding:20rpx;--td-cell-horizontal-padding:20rpx;--td-cell-title-font: 400 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-cell-note-font-size:var(--font-secondary);--td-cell-description-font: 400 var(--font-secondary)/var(--line-height-body) var(--td-font-family);--td-cell-description-color:#82969a;--td-cell-border-color:#e2edf0;--td-input-bg-color:#eff8f8;--td-input-vertical-padding:20rpx;--td-input-label-text-font: 400 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-input-placeholder-text-font: 400 var(--font-secondary)/var(--line-height-body) var(--td-font-family);--td-textarea-background-color:#eff8f8;--td-textarea-padding:20rpx;--td-font-body-large: 400 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-font-body-medium: 400 var(--font-secondary)/var(--line-height-body) var(--td-font-family);--td-textarea-placeholder-color:#9aadb1;--td-button-small-font: 500 var(--font-secondary)/var(--line-height-body) var(--td-font-family);--td-button-small-height:64rpx;}
.editor-group {display:block;overflow:hidden;margin-bottom:10rpx;border-radius:18rpx;}
.editor-photo-action {flex:none;--td-button-primary-bg-color:#73c6e8;--td-button-primary-border-color:#55b2d6;--td-button-primary-color:#345158;--td-button-primary-active-bg-color:#60b9dd;--td-button-primary-active-border-color:#55b2d6;--td-button-primary-disabled-bg:#dceff7;--td-button-primary-disabled-border-color:#dceff7;--td-button-primary-disabled-color:#82969a;--td-button-medium-font:600 var(--font-body)/var(--line-height-body) var(--td-font-family);}
.editor-actions {position:fixed;bottom:0;left:0;right:0;z-index:20;display:flex;gap:16rpx;padding:16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#ffffff;border-top:1rpx solid #e2edf0;--td-button-medium-height:88rpx;--td-button-medium-font: 500 var(--font-body)/var(--line-height-body) var(--td-font-family);--td-button-primary-bg-color:#55bba4;--td-button-primary-border-color:#55bba4;--td-button-default-bg-color:#eff8f8;--td-button-default-border-color:#eff8f8;--td-button-default-color:#82969a;}
.editor-cancel,.editor-save {flex:1 1 0;min-width:0;}
.editor-age-groups {padding:20rpx;background:#eff8f8;}
.editor-age-options {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;}
.editor-age-chip {display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:76rpx;margin:0;padding:14rpx 10rpx;border:2rpx solid #d7e9e7;border-radius:999rpx;background:#fff;color:#345158;font-size:var(--font-secondary);line-height:var(--line-height-body);}
.editor-age-chip::after {border:0;}
.editor-age-chip.is-selected {border-color:#55bba4;background:#55bba4;color:#153f37;font-weight:500;}
.editor-age-chip[disabled] {border-color:#d6eee6;background:#d6eee6;color:#72958b;}
.editor-age-note {margin-top:16rpx;color:#82969a;font-size:var(--font-caption);line-height:var(--line-height-body);}
