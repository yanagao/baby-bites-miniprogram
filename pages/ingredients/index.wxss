.ingredients-page {
  --td-brand-color: #0071e3;
  --td-brand-color-light: #eaf3ff;
  --td-button-medium-height: 88rpx;
  --td-button-medium-font: 600 28rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
.storage-warning { padding: 22rpx; margin-bottom: 24rpx; border-radius: 18rpx; background: #fff5df; color: #785b25; font-size: 25rpx; line-height: 1.6; }
.ingredient-panel { padding: 30rpx; }
.ingredient-panel .section-title, .matches-heading .section-title { margin: 0; }
.panel-copy { font-size: 25rpx; line-height: 1.6; color: #64748b; margin: 10rpx 0 22rpx; }
.ingredient-grid { display: flex; flex-wrap: wrap; margin: -5rpx; }
.ingredient-tag-slot { width: 33.333%; box-sizing: border-box; padding: 5rpx; min-width: 0; }
.ingredient-tag-host {
  display: block;
  --td-tag-large-font: 25rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-tag-large-padding: 12rpx 6rpx;
  --td-tag-square-border-radius: 18rpx;
  --td-tag-default-light-color: #f7f9fc;
  --td-tag-default-font-color: #536b88;
  --td-tag-primary-color: #0071e3;
  --td-tag-primary-light-color: #eaf3ff;
  --td-component-border: #e4eaf2;
}
.ingredient-tag { display: flex !important; width: 100%; min-height: 88rpx; justify-content: center; }
.custom-ingredient { display: flex; align-items: center; margin-top: 24rpx; }
.ingredient-input-host {
  display: block;
  flex: 1 1 0;
  min-width: 0;
  --td-input-bg-color: #f7f9fc;
  --td-input-vertical-padding: 18rpx;
  --td-input-default-text-color: #1d2b3a;
  --td-input-placeholder-text-color: #94a0b2;
  --td-input-placeholder-text-font: 25rpx / 40rpx -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
.ingredient-input { border: 1rpx solid #e4eaf2; border-radius: 18rpx; min-height: 88rpx; box-sizing: border-box; }
.ingredient-input-text { font-size: 25rpx !important; }
.ingredient-add-host { display: block; flex: 0 0 112rpx; width: 112rpx; margin-left: 14rpx; }
.ingredient-add-control { width: 100%; padding: 0 !important; font-size: 26rpx !important; }
.pantry-summary { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; color: #64748b; font-size: 25rpx; margin-top: 8rpx; }
.clear-pantry-host { display: block; --td-button-small-height: 80rpx; --td-button-small-font: 500 25rpx / 1.4 -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.clear-pantry-control { padding-right: 0 !important; }
.complete-filter { display: flex; justify-content: space-between; align-items: center; font-size: 25rpx; color: #536b88; border-top: 1rpx solid #e4eaf2; padding-top: 10rpx; }
.filter-switch-host { display: block; flex-shrink: 0; margin-left: 12rpx; }
.switch-hit-area { min-height: 88rpx; }
.matches-heading { display: flex; justify-content: space-between; align-items: center; margin: 34rpx 0 22rpx; }
.matches-heading .muted { font-size: 25rpx; }
.match-item { margin-bottom: 24rpx; }
.empty-host { display: block; margin-top: 20rpx; --td-empty-description-margin-top: 18rpx; --td-empty-action-margin-top: 28rpx; }
.empty-surface { padding: 64rpx 28rpx; border: 1rpx solid #e4eaf2; border-radius: 28rpx; background: #fff; }
.empty-heading { font-size: 32rpx; font-weight: 600; color: #1d2b3a; line-height: 1.5; }
.empty-description { margin-top: 16rpx; font-size: 26rpx; color: #64748b; line-height: 1.6; }
.empty-action { width: 440rpx; max-width: 100%; }
