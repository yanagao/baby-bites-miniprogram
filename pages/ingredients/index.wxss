.ingredients-page { padding-top: 14rpx; }
.pantry-hero { display: flex; align-items: center; justify-content: space-between; min-height: 144rpx; margin-bottom: 10rpx; }
.pantry-intro { flex: 1; min-width: 0; }
.pantry-title { color: #3b241f; font-size: 46rpx; font-weight: 800; line-height: 1.3; letter-spacing: 1rpx; }
.pantry-subtitle { margin-top: 12rpx; color: #78675f; font-size: 27rpx; line-height: 1.5; }
.pantry-mascot { flex: none; width: 136rpx; height: 136rpx; margin-left: 6rpx; transform: rotate(5deg); }
.pantry-search { --td-search-bg-color: #f0ece3; --td-search-height: 72rpx; --td-search-font: 28rpx / 44rpx -apple-system, BlinkMacSystemFont, sans-serif; --td-search-icon-color: #67564c; --td-search-text-color: #3b241f; --td-search-placeholder-color: #93877e; }
.pantry-selection-bar { display: flex; align-items: center; justify-content: space-between; min-height: 68rpx; }
.selection-count { font-size: 28rpx; font-weight: 600; color: #3b241f; }
.clear-selection { margin: 0; padding: 10rpx 0 10rpx 28rpx; min-height: 56rpx; line-height: 36rpx; background: transparent; color: #e75169; font-size: 27rpx; border-radius: 0; }
.clear-selection::after, .ingredient-tile::after, .all-ingredients::after { border: 0; }
.clear-selection[disabled] { color: #ad9c93; background: transparent; }
.ingredient-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.ingredient-tile { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; min-height: 140rpx; margin: 0; padding: 18rpx 12rpx; color: #3b241f; background: #fffdf8; border: 2rpx solid #ede3d5; border-radius: 24rpx; line-height: 1.3; }
.ingredient-tile-selected { border-color: #cde7b6; background: #edf7e1; color: #225c29; }
.ingredient-tile-pressed { opacity: 0.78; }
.ingredient-label { display: block; margin-top: 12rpx; font-size: 27rpx; font-weight: 600; line-height: 36rpx; overflow-wrap: break-word; }
.ingredient-check { position: absolute; top: 10rpx; right: 10rpx; display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; color: #fff; background: #2e9144; border: 3rpx solid #fffdf8; border-radius: 50%; z-index: 1; }
.pantry-more-actions { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.all-ingredients { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 14rpx 0; min-height: 64rpx; line-height: 36rpx; color: #78675f; background: transparent; font-size: 25rpx; }
.custom-ingredient-toggle { margin-left: auto; color: #c45668; }
.custom-ingredient-panel { overflow: hidden; border-radius: 20rpx; }
.match-filter-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; padding: 5rpx 0; }
.match-filter-label { font-size: 26rpx; color: #78675f; }
.match-section { padding: 16rpx 12rpx 8rpx; margin-bottom: 22rpx; border-radius: 32rpx 38rpx 28rpx 28rpx; }
.match-section-complete { background: #edf6df; }
.match-section-partial { background: #ffede8; }
.match-section-heading { display: flex; align-items: center; gap: 10rpx; padding: 0 6rpx 14rpx; color: #3b241f; font-size: 31rpx; font-weight: 800; line-height: 1.4; }
.match-section-complete .match-section-heading { color: #315d2d; }
.match-section-partial .match-section-heading { color: #a54c3b; }
.pantry-empty-note { display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 30rpx 8rpx; color: #988778; font-size: 25rpx; line-height: 1.6; }

.pantry-title {font-family:PocketBrush,'Kaiti SC','PingFang SC',sans-serif;}
