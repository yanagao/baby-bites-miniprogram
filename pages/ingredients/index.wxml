<t-navbar z-index="100" title="按食材找菜" placeholder />
<t-notice-bar wx:if="{{warning}}" visible theme="warning" content="{{warning}}" />
<view class="page-shell ingredients-page">
  <view class="pantry-hero">
    <view class="pantry-intro">
      <view class="pantry-title">冰箱里，有什么？</view>
      <view class="pantry-subtitle">选好食材，看看能做什么</view>
    </view>
    <image class="pantry-mascot" src="/assets/cute/pocket-mascot.png" mode="aspectFit" aria-hidden="true" />
  </view>
  <view class="pantry-search">
    <t-search value="{{search}}" placeholder="搜索食材" shape="round" bind:change="searchIngredient" maxlength="30" />
  </view>
  <view class="pantry-selection-bar">
    <text class="selection-count">已选 {{pantry.length}} 样</text>
    <button class="clear-selection" disabled="{{!pantry.length}}" bindtap="clearPantry" aria-label="清空已选食材">清空</button>
  </view>
  <view class="ingredient-grid" wx:if="{{options.length}}">
    <button wx:for="{{options}}" wx:key="value" class="ingredient-tile {{item.selected ? 'ingredient-tile-selected' : ''}}" hover-class="ingredient-tile-pressed" data-name="{{item.value}}" bindtap="toggleIngredient" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.label}}">
      <view class="ingredient-check" wx:if="{{item.selected}}"><t-icon name="check" size="22rpx" /></view>
      <food-art name="{{item.label}}" size="76" align-to-label />
      <text class="ingredient-label">{{item.label}}</text>
    </button>
  </view>
  <t-empty wx:else description="没有找到这项食材，可以在下面添加" />
  <view class="pantry-more-actions">
    <button wx:if="{{!search}}" class="all-ingredients" bindtap="toggleAllIngredients">
      <text>{{showAllIngredients ? '收起完整列表' : '全部 ' + ingredientCount + ' 种食材'}}</text>
      <t-icon name="{{showAllIngredients ? 'chevron-up' : 'chevron-down'}}" size="26rpx" />
    </button>
    <button class="all-ingredients custom-ingredient-toggle" bindtap="toggleCustomIngredients">
      <t-icon name="{{customPanels.length ? 'chevron-up' : 'add'}}" size="26rpx" />
      <text>{{customPanels.length ? '收起' : '添加其他食材'}}</text>
    </button>
  </view>
  <view wx:if="{{customPanels.length}}" class="custom-ingredient-panel">
    <t-input label="食材" value="{{ingredient}}" bind:change="inputIngredient" bind:enter="addIngredient" placeholder="例如：冬瓜" maxlength="30" confirm-type="done">
      <t-button slot="suffix" theme="primary" variant="text" size="small" bind:tap="addIngredient">添加</t-button>
    </t-input>
  </view>
  <block wx:if="{{pantry.length}}">
    <view class="match-filter-row">
      <text class="match-filter-label">只看食材齐全</text>
      <t-switch value="{{completeOnly}}" bind:change="changeComplete" aria-label="只看食材齐全" size="small" />
    </view>
    <view wx:if="{{completeMatches.length}}" class="match-section match-section-complete">
      <view class="match-section-heading"><t-icon name="check-circle-filled" size="30rpx" /><text>食材已齐 · {{completeMatches.length}} 道</text></view>
      <recipe-card wx:for="{{completeMatches}}" wx:key="id" recipe="{{item}}" bind:open="openRecipe" />
    </view>
    <view wx:if="{{partialMatches.length}}" class="match-section match-section-partial">
      <view class="match-section-heading"><t-icon name="add-circle" size="30rpx" /><text>再添一点 · 也能做</text></view>
      <recipe-card wx:for="{{partialMatches}}" wx:key="id" recipe="{{item}}" bind:open="openRecipe" />
    </view>
    <t-empty wx:if="{{!matches.length}}" description="{{completeOnly ? '还没有食材齐全的菜谱，试试关闭筛选' : '已有菜谱中没有匹配结果，试试多选几样食材'}}">
      <t-button slot="action" theme="primary" variant="outline" bind:tap="selectIngredients">继续选食材</t-button>
    </t-empty>
  </block>
  <view wx:else class="pantry-empty-note"><t-icon name="lightbulb" size="30rpx" /><text>点一点手边的食材，小口袋帮你找菜</text></view>
</view>
<bottom-navigation id="bottom-navigation" />
