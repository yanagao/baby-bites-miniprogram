page {
  background: #fffaf1; color: #3e2722; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --td-brand-color: #ee5b73; --td-brand-color-active: #d94962; --td-brand-color-light: #ffedf0; --td-brand-color-light-active: #ffe1e6;
  --td-text-color-primary: #3e2722; --td-text-color-secondary: #85746b; --td-bg-color-page: #fffaf1;
  --td-navbar-bg-color: #fffaf1; --td-navbar-color: #3e2722; --td-navbar-title-font-weight: 600;
  --td-button-primary-bg-color: #ee5b73; --td-button-primary-border-color: #ee5b73; --td-button-border-radius: 999rpx;
  --td-button-default-color: #754334; --td-button-default-border-color: #d9bc9e;
  --td-search-bg-color: #f2ede5; --td-search-border-radius: 28rpx; --td-search-result-high-light-color: #ee5b73;
  --td-tabs-bg-color: transparent; --td-tabs-item-active-color: #e84966; --td-tabs-track-color: #ee5b73;
  --td-tab-bar-bg-color: #fffaf3; --td-tab-bar-item-color: #4b332b; --td-tab-bar-item-active-color: #e74965;
  --td-tab-bar-active-bg: #ffe4e7; --td-switch-checked-color: #ee5b73; --td-cell-bg-color: #fffdfa;
  --td-cell-group-title-bg-color: #fffaf1; --td-cell-group-title-color: #9c8271;
  --td-input-bg-color: #fffdfa; --td-textarea-background-color: #fffdfa;
}
view, text, button {box-sizing: border-box;}

.page-shell {padding: 24rpx 30rpx 28rpx;}
.page-title {font-family: PocketBrush, 'Kaiti SC', 'STKaiti', 'PingFang SC', sans-serif; font-size: 60rpx; line-height: 1.22; font-weight: 700; color: #42251e;}
.brush {font-family: PocketBrush, 'Kaiti SC', 'STKaiti', 'PingFang SC', sans-serif;}
.muted {color: #8d7c70; font-size: 26rpx; line-height: 1.6;}
.form-error {--td-cell-description-color: var(--td-error-color, #d54941);}
.panel {background: #fff; border-radius: 30rpx; border: 1rpx solid #f1e8d9; box-shadow: 0 5rpx 18rpx rgba(92,55,24,.035);}
.pink-button {margin: 0; background: #ee5b73; color: #fff; border-radius: 999rpx; min-height: 88rpx; line-height: 88rpx; font-size: 32rpx; font-weight: 600;}
.pink-button[disabled] {background: #f4c3cb; color: #fff;}
.pill {display: inline-flex; align-items: center; border-radius: 999rpx; padding: 6rpx 20rpx; font-size: 24rpx; background: #ffedf0; color: #b84b60;}
.pill-green {background: #e8f4df; color: #4d784a;}
.section-title {font-family: PocketBrush, 'Kaiti SC', 'PingFang SC', sans-serif; font-size: 36rpx; font-weight: 600;}
.empty-note {padding: 48rpx 28rpx; text-align: center; font-size: 28rpx; color: #8a786b; line-height: 1.7;}

.pink-button::after {border:0;}
