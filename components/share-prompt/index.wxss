.share-prompt {position:fixed;left:24rpx;right:24rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));z-index:120;padding:24rpx;box-sizing:border-box;border:1rpx solid #dcebe8;border-radius:24rpx;background:#fff;color:#345158;box-shadow:0 8rpx 40rpx rgba(52,81,88,.12);}
.share-prompt-message {font-size:var(--font-body,30rpx);line-height:1.6;font-weight:500;}
.share-prompt-note {margin-top:8rpx;color:#607d83;font-size:var(--font-caption,24rpx);line-height:1.6;}
.share-prompt-error {margin-top:8rpx;color:#a2543d;font-size:var(--font-caption,24rpx);line-height:1.6;}
.share-prompt-actions {display:flex;gap:16rpx;margin-top:20rpx;}
.share-prompt-action {display:flex;flex:1;align-items:center;justify-content:center;min-width:0;min-height:80rpx;margin:0;padding:16rpx 8rpx;border:1rpx solid #c9dfda;border-radius:18rpx;background:#eff8f8;color:#345158;font-size:var(--font-secondary,26rpx);font-weight:500;line-height:1.5;}
.share-prompt-action::after {border:0;}
.share-prompt-action[disabled] {color:#82969a;background:#f3f7f6;}
