<view class="recipe-card" hover-class="recipe-card-pressed" bindtap="open" aria-role="button" aria-label="查看{{recipe.name}}的做法">
  <image wx:if="{{recipe.displayPhoto}}" class="recipe-photo" src="{{recipe.displayPhoto}}" mode="aspectFill" />
  <view wx:else class="recipe-art"><food-art name="{{recipe.ingredients[0].name || ''}}" size="104" /></view>
  <view class="recipe-copy">
    <view class="recipe-name">{{recipe.name}}</view>
    <view class="recipe-meta"><t-icon name="time" size="24rpx" /><text>{{recipe.minutes}} 分钟 · {{recipe.texture}}</text></view>
    <view wx:if="{{recipe.totalCount}}" class="recipe-match {{recipe.complete ? 'recipe-match-complete' : 'recipe-match-partial'}}"><t-icon name="{{recipe.complete ? 'check-circle-filled' : 'error-circle-filled'}}" size="24rpx" /><text>{{recipe.complete ? '食材已齐' : '还缺 ' + recipe.missingCount + ' 样：' + recipe.missingText}}</text></view>
    <view wx:elif="{{recipe.rating > 0}}" class="recipe-preference preference-{{recipe.rating}}">上次{{recipe.ratingName}}</view>
    <view wx:else class="recipe-ingredients">{{recipe.ingredientText}}</view>
  </view>
  <t-icon name="chevron-right" size="32rpx" color="#765e50" />
</view>
